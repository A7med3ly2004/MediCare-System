@model MediCare.Web.ViewModels.Admin.AdminAppointmentsListViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Appointment Management";
    var paging = Model.Paging;
}

<div class="mc-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <span class="mc-page-label">CLINIC SCHEDULE</span>
            <h1 class="mc-page-title mb-1">Appointment Management</h1>
            <p class="mc-page-subtitle">Schedule oversight, status changes, and administrative confirmations</p>
        </div>
    </div>
</div>

<!-- KPI Cards (UI Match: Appointment management — day.png) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="mc-card p-3 h-100">
            <span class="text-secondary small d-block mb-1">Total Appointments</span>
            <div class="h3 fw-bold text-ink mb-0">@Model.TotalAppointments</div>
            <span class="text-secondary small">For filtered criteria</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="mc-card p-3 h-100">
            <span class="text-secondary small d-block mb-1">Confirmed</span>
            <div class="h3 fw-bold text-primary mb-0">@Model.ConfirmedCount</div>
            <span class="text-secondary small">Active bookings</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="mc-card p-3 h-100">
            <span class="text-secondary small d-block mb-1">Pending Requests</span>
            <div class="h3 fw-bold text-warning mb-0">@Model.PendingCount</div>
            <span class="text-secondary small">Awaiting review</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="mc-card p-3 h-100">
            <span class="text-secondary small d-block mb-1">Completed</span>
            <div class="h3 fw-bold text-success mb-0">@Model.CompletedCount</div>
            <span class="text-secondary small">Fulfilled visits</span>
        </div>
    </div>
</div>

<!-- Filters Bar -->
<div class="mc-card p-3 mb-4">
    <form method="get" asp-controller="Admin" asp-action="Appointments" class="row g-2 align-items-center">
        <div class="col-12 col-sm-6 col-md-3">
            <label class="form-label small fw-medium mb-1">Date</label>
            <input type="date" name="date" value="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-12 col-sm-6 col-md-4">
            <label class="form-label small fw-medium mb-1">Doctor</label>
            <select name="doctorId" class="form-select form-select-sm">
                <option value="">All Doctors</option>
                @foreach (var doc in Model.Doctors)
                {
                    <option value="@doc.Id" selected="@(Model.DoctorId == doc.Id ? "selected" : null)">@doc.FullName (@doc.SpecializationName)</option>
                }
            </select>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <label class="form-label small fw-medium mb-1">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<MediCare.Data.Entities.AppointmentStatus>())
                {
                    <option value="@s" selected="@(Model.Status == s ? "selected" : null)">@s</option>
                }
            </select>
        </div>
        <div class="col-12 col-sm-6 col-md-2 d-flex align-items-end gap-2 pt-md-4">
            <button type="submit" class="btn btn-primary btn-sm flex-fill">Apply</button>
            <a asp-controller="Admin" asp-action="Appointments" class="btn btn-light btn-sm border">Clear</a>
        </div>
    </form>
</div>

<!-- Appointments Table (UI Match: Appointment management — day.png) -->
<div class="mc-card p-4">
    @if (paging.Items.Count == 0)
    {
        <div class="p-5 text-center text-secondary">
            <i class="bi bi-calendar-x fs-2 text-muted d-block mb-2"></i>
            <p class="mb-0">No appointments found matching the selected filters.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table mc-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Patient</th>
                        <th>Attending Doctor</th>
                        <th>Consultation Fee</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in paging.Items)
                    {
                        var statusClass = appt.Status switch
                        {
                            MediCare.Data.Entities.AppointmentStatus.Confirmed => "confirmed",
                            MediCare.Data.Entities.AppointmentStatus.Pending => "pending",
                            MediCare.Data.Entities.AppointmentStatus.Completed => "completed",
                            MediCare.Data.Entities.AppointmentStatus.Cancelled => "cancelled",
                            _ => "rejected"
                        };
                        var rowVer = Convert.ToBase64String(appt.RowVersion);

                        <tr>
                            <td>
                                <div class="fw-semibold text-ink">@appt.AppointmentDate.ToString("yyyy-MM-dd")</div>
                                <span class="text-secondary small">@appt.FormattedTime</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-ink">@appt.PatientName</div>
                                <span class="badge bg-light text-secondary border font-monospace" style="font-size: 11px;">@appt.PatientCode</span>
                                @if (!string.IsNullOrEmpty(appt.PatientPhone))
                                {
                                    <span class="text-muted small d-block">@appt.PatientPhone</span>
                                }
                            </td>
                            <td>
                                <div class="text-ink fw-medium">@appt.DoctorName</div>
                                <span class="text-secondary small">@appt.SpecializationName</span>
                                @if (!string.IsNullOrEmpty(appt.RoomNumber))
                                {
                                    <span class="text-secondary small">· Room @appt.RoomNumber</span>
                                }
                            </td>
                            <td class="fw-semibold text-ink">
                                @appt.ConsultationFee.ToString("N0") EGP
                            </td>
                            <td>
                                <span class="mc-badge mc-badge--@statusClass">@appt.Status</span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    @if (appt.Status == MediCare.Data.Entities.AppointmentStatus.Pending)
                                    {
                                        <!-- Confirm Button -->
                                        <form asp-controller="Admin" asp-action="ConfirmAppointment" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="appointmentId" value="@appt.Id" />
                                            <input type="hidden" name="rowVersionBase64" value="@rowVer" />
                                            <button type="submit" class="btn btn-outline-success btn-sm" title="Confirm Appointment">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>

                                        <!-- Reject Modal Trigger -->
                                        <button type="button" class="btn btn-outline-danger btn-sm" title="Reject Appointment" data-bs-toggle="modal" data-bs-target="#rejectModal-@appt.Id">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }

                                    @if (appt.Status == MediCare.Data.Entities.AppointmentStatus.Pending || appt.Status == MediCare.Data.Entities.AppointmentStatus.Confirmed)
                                    {
                                        <!-- Cancel Modal Trigger -->
                                        <button type="button" class="btn btn-outline-secondary btn-sm" title="Cancel Appointment" data-bs-toggle="modal" data-bs-target="#cancelModal-@appt.Id">
                                            <i class="bi bi-slash-circle"></i>
                                        </button>
                                    }
                                </div>

                                <!-- Reject Modal -->
                                <div class="modal fade" id="rejectModal-@appt.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start">
                                            <form asp-controller="Admin" asp-action="RejectAppointment" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="appointmentId" value="@appt.Id" />
                                                <input type="hidden" name="rowVersionBase64" value="@rowVer" />
                                                <div class="modal-header">
                                                    <h5 class="modal-title h6 fw-bold">Reject Appointment #@appt.Id</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="text-secondary small">Are you sure you want to reject this appointment request for <strong>@appt.PatientName</strong> with <strong>@appt.DoctorName</strong>?</p>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Rejection Reason</label>
                                                        <input type="text" name="reason" class="form-control" placeholder="e.g. Doctor unavailable / schedule conflict" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger btn-sm">Reject Appointment</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Cancel Modal -->
                                <div class="modal fade" id="cancelModal-@appt.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start">
                                            <form asp-controller="Admin" asp-action="CancelAppointment" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="appointmentId" value="@appt.Id" />
                                                <div class="modal-header">
                                                    <h5 class="modal-title h6 fw-bold">Cancel Appointment #@appt.Id</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="text-secondary small">Cancel appointment for <strong>@appt.PatientName</strong> on @appt.AppointmentDate.ToString("yyyy-MM-dd") at @appt.FormattedTime?</p>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Cancellation Reason</label>
                                                        <input type="text" name="reason" class="form-control" placeholder="e.g. Administrative cancellation / patient requested" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Keep</button>
                                                    <button type="submit" class="btn btn-danger btn-sm">Cancel Appointment</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (paging.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-4">
                <span class="text-secondary small">Showing page @paging.PageNumber of @paging.TotalPages (@paging.TotalCount appointments)</span>
                <nav aria-label="Appointments pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!paging.HasPrevious ? "disabled" : "")">
                            <a class="page-link" asp-controller="Admin" asp-action="Appointments" asp-route-page="@(paging.PageNumber - 1)" asp-route-date="@Model.SelectedDate?.ToString("yyyy-MM-dd")" asp-route-doctorId="@Model.DoctorId" asp-route-status="@Model.Status">Previous</a>
                        </li>
                        @for (int p = 1; p <= paging.TotalPages; p++)
                        {
                            <li class="page-item @(p == paging.PageNumber ? "active" : "")">
                                <a class="page-link" asp-controller="Admin" asp-action="Appointments" asp-route-page="@p" asp-route-date="@Model.SelectedDate?.ToString("yyyy-MM-dd")" asp-route-doctorId="@Model.DoctorId" asp-route-status="@Model.Status">@p</a>
                            </li>
                        }
                        <li class="page-item @(!paging.HasNext ? "disabled" : "")">
                            <a class="page-link" asp-controller="Admin" asp-action="Appointments" asp-route-page="@(paging.PageNumber + 1)" asp-route-date="@Model.SelectedDate?.ToString("yyyy-MM-dd")" asp-route-doctorId="@Model.DoctorId" asp-route-status="@Model.Status">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>
