@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Registration Submitted";
    var email = ViewBag.Email as string ?? "your email address";
}

<div class="mc-auth-card text-center" style="max-width: 500px;">
    <div class="mb-4">
        <a asp-controller="Home" asp-action="Index" class="mc-auth-logo justify-content-center">
            <img src="~/images/logo.png" alt="MediCare" class="mc-auth-logo-icon" />
            <span>MediCare</span>
        </a>
    </div>

    <div class="my-4">
        <div class="mx-auto mb-3" style="width: 64px; height: 64px; background-color: var(--mc-primary-light); color: var(--mc-confirmed-text); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 32px;">
            <i class="bi bi-envelope-check"></i>
        </div>
        <h1 class="mc-auth-title">Verify your email</h1>
        <p class="text-secondary small mt-2">
            We have created your account for <strong class="text-ink">@email</strong>.
        </p>
    </div>

    <div class="mc-alert mc-alert-info text-start mb-4" style="background-color: var(--mc-primary-light); border-left: 4px solid var(--mc-primary); padding: 16px; border-radius: var(--mc-radius-sm);">
        <div class="d-flex align-items-start">
            <i class="bi bi-info-circle-fill me-2 fs-5" style="color: var(--mc-confirmed-text);"></i>
            <div class="small text-ink">
                <strong>Next Step: Email Verification (Task 2B)</strong><br />
                Your account is currently <em>inactive</em> (<code class="small">IsEmailVerified = false</code>). Email OTP verification with SendGrid will be activated in the next step.
            </div>
        </div>
    </div>

    <p class="text-secondary small mb-4">
        Once verified, you will be able to sign in and access your personal clinic workspace.
    </p>

    <div class="d-grid gap-2">
        <a asp-controller="Account" asp-action="Login" class="mc-btn mc-btn-primary">
            Back to Sign In
        </a>
        <a asp-controller="Home" asp-action="Index" class="mc-btn mc-btn-ghost">
            Return to Home
        </a>
    </div>
</div>
