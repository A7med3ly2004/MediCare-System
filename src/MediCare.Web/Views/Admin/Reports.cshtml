@model MediCare.Web.ViewModels.Admin.AdminReportsViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Reports & Analytics";
    var report = Model.DailyReport;
    var analytics = Model.Analytics;
    decimal completionRate = report.AppointmentsBooked > 0
        ? Math.Round((decimal)report.CompletedConsultations / report.AppointmentsBooked * 100m, 1)
        : 0m;
}

<div class="mc-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <span class="mc-page-label">CLINIC INTELLIGENCE</span>
            <h1 class="mc-page-title mb-1">Reports & Analytics</h1>
            <p class="mc-page-subtitle">Historical performance trends, provider metrics, and exportable daily reports</p>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-2">
            <!-- Date Filter for Daily Report -->
            <form method="get" asp-controller="Admin" asp-action="Reports" class="d-flex align-items-center gap-2">
                <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="max-width: 160px; background: var(--mc-surface); border-color: var(--mc-hairline); color: var(--mc-ink);" />
                <button type="submit" class="btn btn-sm" style="background: var(--mc-surface); border: 1px solid var(--mc-hairline); color: var(--mc-ink);">
                    <i class="bi bi-funnel me-1"></i> Apply
                </button>
            </form>

            <!-- Export Buttons (FR-35) -->
            <div class="btn-group btn-group-sm">
                <a asp-controller="Admin" asp-action="ExportReport" asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")" asp-route-format="excel" class="btn btn-outline-success">
                    <i class="bi bi-file-earmark-excel me-1"></i> Excel
                </a>
                <a asp-controller="Admin" asp-action="ExportReport" asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")" asp-route-format="pdf" class="btn btn-outline-danger">
                    <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                </a>
            </div>

            <!-- NFR-02 Volume Seeder Dev Action -->
            <form asp-controller="Admin" asp-action="SeedVolume" method="post" class="d-inline" onsubmit="return confirm('Generate 10,000 sample appointments for performance evaluation?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="count" value="10000" />
                <button type="submit" class="btn btn-sm" style="background: var(--mc-surface); border: 1px solid var(--mc-hairline); color: var(--mc-secondary-text);" title="Seed 10,000 appointments to test NFR-02 response time">
                    <i class="bi bi-lightning-charge me-1"></i> Seed 10k (NFR-02)
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Daily Report Summary Banner (UI Match: Reports and analytics.png) -->
<div class="mc-card p-4 mb-4" style="background: linear-gradient(135deg, var(--mc-surface) 0%, var(--mc-primary-light) 100%); border: 1px solid var(--mc-hairline);">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="h6 mb-0 fw-bold text-ink">Daily Summary — @Model.SelectedDate.ToString("dddd, MMMM dd, yyyy")</h2>
            <span class="text-secondary small">Comprehensive audit of daily operational metrics</span>
        </div>
        <span class="badge" style="background-color: var(--mc-primary-light); color: var(--mc-confirmed-text); border: 1px solid var(--mc-hairline);">
            Daily Audit Active
        </span>
    </div>

    <div class="row g-3">
        <div class="col-6 col-md-3">
            <div class="p-3 rounded" style="background: var(--mc-surface); border: 1px solid var(--mc-hairline);">
                <span class="text-secondary small d-block mb-1">New Patients</span>
                <div class="h4 fw-bold text-ink mb-0">@report.NewPatientRegistrations</div>
                <span class="text-secondary" style="font-size: 11px;">@report.NewDoctorRegistrations staff joined</span>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="p-3 rounded" style="background: var(--mc-surface); border: 1px solid var(--mc-hairline);">
                <span class="text-secondary small d-block mb-1">Appointments Booked</span>
                <div class="h4 fw-bold text-ink mb-0">@report.AppointmentsBooked</div>
                <span class="text-secondary" style="font-size: 11px;">@report.AppointmentsConfirmed confirmed</span>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="p-3 rounded" style="background: var(--mc-surface); border: 1px solid var(--mc-hairline);">
                <span class="text-secondary small d-block mb-1">Completed Consultations</span>
                <div class="h4 fw-bold text-ink mb-0">@report.CompletedConsultations</div>
                <span class="text-success" style="font-size: 11px;">@completionRate% fulfillment rate</span>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="p-3 rounded" style="background: var(--mc-surface); border: 1px solid var(--mc-hairline);">
                <span class="text-secondary small d-block mb-1">Estimated Revenue</span>
                <div class="h4 fw-bold text-ink mb-0">@report.EstimatedRevenue.ToString("N0") <span class="fs-6 fw-normal text-secondary">EGP</span></div>
                <span class="text-secondary" style="font-size: 11px;">@report.AppointmentsCancelled cancelled</span>
            </div>
        </div>
    </div>
</div>

<!-- 12-Month Trend and Patient Growth Charts -->
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-8">
        <div class="mc-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h6 mb-0 fw-bold text-ink">Appointment Trends (Last 12 Months)</h2>
                    <span class="text-secondary small">Comparison of booked vs completed consultations</span>
                </div>
                <span class="badge" style="background: var(--mc-canvas); color: var(--mc-secondary-text); border: 1px solid var(--mc-hairline);">Grouped DB aggregation</span>
            </div>
            <div style="height: 260px; position: relative;">
                <canvas id="monthlyTrendChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="mc-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h6 mb-0 fw-bold text-ink">Patient Growth</h2>
                    <span class="text-secondary small">New accounts per month</span>
                </div>
                <span class="badge" style="background: var(--mc-canvas); color: var(--mc-secondary-text); border: 1px solid var(--mc-hairline);">Last 6 months</span>
            </div>
            <div style="height: 260px; position: relative;">
                <canvas id="patientGrowthChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Provider Performance & Specializations Breakdown (UI Match: Reports and analytics.png) -->
<div class="row g-3">
    <!-- Top Doctors Table (Col-7) -->
    <div class="col-12 col-lg-7">
        <div class="mc-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h6 mb-0 fw-bold text-ink">Provider Performance</h2>
                    <span class="text-secondary small">Doctor consultation fulfillment and revenue</span>
                </div>
                <a asp-controller="Admin" asp-action="Doctors" class="small text-primary text-decoration-none">Manage Doctors</a>
            </div>

            <div class="table-responsive">
                <table class="table mc-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Doctor</th>
                            <th>Specialization</th>
                            <th class="text-center">Assigned</th>
                            <th class="text-center">Completed</th>
                            <th class="text-end">Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (analytics.TopDoctors.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-secondary">No doctor performance data recorded yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var doc in analytics.TopDoctors)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-medium text-ink">@doc.DoctorName</div>
                                    </td>
                                    <td>
                                        <span class="text-secondary small">@doc.Specialization</span>
                                    </td>
                                    <td class="text-center fw-medium">
                                        @doc.TotalAssigned
                                    </td>
                                    <td class="text-center">
                                        <span class="badge fw-bold" style="background: var(--mc-canvas); color: #16A34A; border: 1px solid var(--mc-hairline);">@doc.CompletedVisits</span>
                                        <span class="text-secondary small d-block" style="font-size: 10px;">@doc.CompletionRate%</span>
                                    </td>
                                    <td class="text-end fw-semibold text-ink">
                                        @doc.Revenue.ToString("N0") EGP
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Popular Specializations Breakdown (Col-5) -->
    <div class="col-12 col-lg-5">
        <div class="mc-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h6 mb-0 fw-bold text-ink">Popular Specializations</h2>
                    <span class="text-secondary small">Booking distribution across clinical domains</span>
                </div>
                <a asp-controller="Admin" asp-action="Specializations" class="small text-primary text-decoration-none">Setup</a>
            </div>

            @if (analytics.PopularSpecializations.Count == 0)
            {
                <div class="p-4 text-center text-secondary">No specialization appointment data available.</div>
            }
            else
            {
                int maxAppts = analytics.PopularSpecializations.Max(s => s.AppointmentCount);
                if (maxAppts == 0) maxAppts = 1;

                <div class="d-flex flex-column gap-3">
                    @foreach (var spec in analytics.PopularSpecializations)
                    {
                        var pct = Math.Round((decimal)spec.AppointmentCount / maxAppts * 100m, 0);

                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-medium text-ink small">@spec.SpecializationName</span>
                                <span class="text-secondary small">@spec.AppointmentCount visits · @spec.DoctorCount docs</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar" role="progressbar" style="width: @pct%; background-color: var(--mc-primary, #0284C7);" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        function getChartColors() {
            const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            return {
                text: isDark ? '#94A3B8' : '#607280',
                grid: isDark ? 'rgba(255, 255, 255, 0.08)' : '#F1F5F9',
                barBooked: isDark ? '#38BDF8' : '#90D0F2',
                barCompleted: isDark ? '#4ADE80' : '#16A34A',
                barCancelled: isDark ? '#F87171' : '#DC2626',
                lineBorder: isDark ? '#38BDF8' : '#0284C7',
                lineBg: isDark ? 'rgba(56, 189, 248, 0.15)' : 'rgba(2, 132, 199, 0.1)'
            };
        }

        const colors = getChartColors();

        // 12-Month Trends Chart
        const trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(analytics.MonthlyTrends.Select(t => t.Month)));
        const bookedData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(analytics.MonthlyTrends.Select(t => t.TotalBooked)));
        const completedData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(analytics.MonthlyTrends.Select(t => t.Completed)));
        const cancelledData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(analytics.MonthlyTrends.Select(t => t.Cancelled)));

        const trendCtx = document.getElementById('monthlyTrendChart').getContext('2d');
        const trendChart = new Chart(trendCtx, {
            type: 'bar',
            data: {
                labels: trendLabels,
                datasets: [
                    {
                        label: 'Booked',
                        data: bookedData,
                        backgroundColor: colors.barBooked,
                        borderRadius: 3
                    },
                    {
                        label: 'Completed',
                        data: completedData,
                        backgroundColor: colors.barCompleted,
                        borderRadius: 3
                    },
                    {
                        label: 'Cancelled',
                        data: cancelledData,
                        backgroundColor: colors.barCancelled,
                        borderRadius: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            boxWidth: 12,
                            font: { size: 11 },
                            color: colors.text
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: colors.grid },
                        ticks: { precision: 0, color: colors.text }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: colors.text }
                    }
                }
            }
        });

        // Patient Growth Chart
        const growthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(analytics.PatientGrowth.Select(g => g.Month)));
        const growthData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(analytics.PatientGrowth.Select(g => g.NewPatients)));

        const growthCtx = document.getElementById('patientGrowthChart').getContext('2d');
        const growthChart = new Chart(growthCtx, {
            type: 'line',
            data: {
                labels: growthLabels,
                datasets: [{
                    label: 'New Patients',
                    data: growthData,
                    borderColor: colors.lineBorder,
                    backgroundColor: colors.lineBg,
                    tension: 0.3,
                    fill: true,
                    borderWidth: 2,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: colors.grid },
                        ticks: { precision: 0, color: colors.text }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: colors.text }
                    }
                }
            }
        });

        // Dynamically update charts on Dark/Light theme toggle
        document.addEventListener('themeChanged', function () {
            const updated = getChartColors();
            if (trendChart) {
                trendChart.options.scales.y.grid.color = updated.grid;
                trendChart.options.scales.y.ticks.color = updated.text;
                trendChart.options.scales.x.ticks.color = updated.text;
                trendChart.options.plugins.legend.labels.color = updated.text;
                trendChart.data.datasets[0].backgroundColor = updated.barBooked;
                trendChart.data.datasets[1].backgroundColor = updated.barCompleted;
                trendChart.data.datasets[2].backgroundColor = updated.barCancelled;
                trendChart.update();
            }
            if (growthChart) {
                growthChart.options.scales.y.grid.color = updated.grid;
                growthChart.options.scales.y.ticks.color = updated.text;
                growthChart.options.scales.x.ticks.color = updated.text;
                growthChart.data.datasets[0].borderColor = updated.lineBorder;
                growthChart.data.datasets[0].backgroundColor = updated.lineBg;
                growthChart.update();
            }
        });
    </script>
}
