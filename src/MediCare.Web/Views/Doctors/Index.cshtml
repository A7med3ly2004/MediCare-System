@model IEnumerable<MediCare.Data.Entities.Doctor>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Doctors Directory";
}

<div class="mc-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <span class="mc-page-label">FIND CARE</span>
            <h1 class="mc-page-title mb-1">Doctors Directory</h1>
            <p class="mc-page-subtitle">Find and book appointments with certified clinic specialists</p>
        </div>
        <div>
            <span class="badge" style="background-color: var(--mc-primary-light); color: var(--mc-confirmed-text); font-size: 13px; padding: 8px 14px;">
                <i class="bi bi-person-check me-1"></i> Patient Portal Active
            </span>
        </div>
    </div>
</div>

<!-- Search & Filter Bar (UI Match: Doctors directory.png) -->
<div class="mc-card p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="position-relative">
                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary"></i>
                <input type="text" class="form-control mc-input ps-5" placeholder="Search doctor by name or keyword…" />
            </div>
        </div>
        <div class="col-12 col-md-4">
            <select class="form-select mc-input">
                <option value="">All Specialties</option>
                <option>Cardiology</option>
                <option>Dermatology</option>
                <option>Pediatrics</option>
                <option>Orthopedics</option>
                <option>Dentistry</option>
            </select>
        </div>
        <div class="col-12 col-md-3">
            <button type="button" class="mc-btn mc-btn-primary w-100">
                <i class="bi bi-funnel me-1"></i> Filter Doctors
            </button>
        </div>
    </div>
</div>

<!-- Doctors Grid -->
<div class="row g-3">
    @if (Model != null && Model.Any())
    {
        @foreach (var doctor in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="mc-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div style="width: 52px; height: 52px; background-color: var(--mc-primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 600; color: var(--mc-ink); overflow: hidden; flex-shrink: 0;">
                                @if (!string.IsNullOrEmpty(doctor.ProfileImage))
                                {
                                    <img src="@doctor.ProfileImage" alt="@doctor.User?.FullName" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <span>@(doctor.User?.FullName?.Length > 0 ? doctor.User.FullName.Substring(0, 1) : "D")</span>
                                }
                            </div>
                            <div>
                                <h2 class="h6 mb-1 fw-bold text-ink">@(doctor.User?.FullName ?? "Dr. Specialist")</h2>
                                <span class="badge mb-1" style="background-color: var(--mc-primary-light); color: var(--mc-confirmed-text); font-size: 11px;">
                                    @(doctor.Specialization?.Name ?? "General Practice")
                                </span>
                                <p class="text-secondary small mb-0">
                                    <i class="bi bi-geo-alt"></i> @doctor.Location
                                </p>
                            </div>
                        </div>

                        <div class="p-2 rounded mb-3" style="background-color: var(--mc-canvas); border: 1px solid var(--mc-hairline); font-size: 12px;">
                            <div class="d-flex justify-content-between">
                                <span class="text-secondary">Consultation fee:</span>
                                <strong class="text-ink">@doctor.ConsultationFee.ToString("N0") EGP</strong>
                            </div>
                            @if (!string.IsNullOrEmpty(doctor.RoomNumber))
                            {
                                <div class="d-flex justify-content-between mt-1">
                                    <span class="text-secondary">Clinic room:</span>
                                    <span class="text-ink">@doctor.RoomNumber</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div>
                        <button type="button" class="mc-btn mc-btn-primary w-100" disabled title="Booking will be implemented in Task 3">
                            <i class="bi bi-calendar-plus me-1"></i> Book Appointment (Task 3)
                        </button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="mc-card p-5 text-center">
                <i class="bi bi-people fs-1 text-secondary mb-2 d-block"></i>
                <h3 class="h5 text-ink">Doctors Directory Placeholder</h3>
                <p class="text-secondary small">Seed data doctors will be listed here.</p>
            </div>
        </div>
    }
</div>
