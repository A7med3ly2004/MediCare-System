@model IEnumerable<MediCare.Data.Entities.Notification>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Doctor Notifications";
}

<div class="mc-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <span class="mc-page-label">COMMUNICATIONS & ALERTS</span>
            <h1 class="mc-page-title mb-1">My Notifications</h1>
            <p class="mc-page-subtitle">Patient booking requests, confirmations, cancellations, and clinic notices</p>
        </div>
        <div>
            <a asp-controller="Doctor" asp-action="Schedule" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-calendar3 me-1"></i> My Schedule
            </a>
        </div>
    </div>
</div>

<div class="mc-card p-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bell-slash text-secondary display-4 d-block mb-3"></i>
            <h5 class="fw-bold text-ink mb-1">No notifications yet</h5>
            <p class="text-secondary small mb-0">You will receive notifications here when patients book, confirm, or modify appointments on your schedule.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="text-secondary small text-uppercase" style="border-bottom: 1px solid var(--mc-hairline);">
                        <th>Date & Time</th>
                        <th>Type</th>
                        <th>Subject</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in Model)
                    {
                        var statusBg = n.Status == MediCare.Data.Entities.NotificationStatus.Sent ? "var(--mc-status-confirmed-bg)" :
                                       n.Status == MediCare.Data.Entities.NotificationStatus.Pending ? "var(--mc-status-pending-bg)" : "var(--mc-status-cancelled-bg)";
                        var statusColor = n.Status == MediCare.Data.Entities.NotificationStatus.Sent ? "var(--mc-status-confirmed-text)" :
                                          n.Status == MediCare.Data.Entities.NotificationStatus.Pending ? "var(--mc-status-pending-text)" : "var(--mc-status-cancelled-text)";
                        <tr style="border-bottom: 1px solid var(--mc-hairline);">
                            <td class="text-ink text-nowrap">
                                <div>@n.CreatedAt.ToString("MMM dd, yyyy")</div>
                                <span class="text-secondary small">@n.CreatedAt.ToString("hh:mm tt") UTC</span>
                            </td>
                            <td>
                                <span class="badge" style="background: var(--mc-canvas); color: var(--mc-ink); border: 1px solid var(--mc-hairline); font-weight: 500;">
                                    @n.Type
                                </span>
                            </td>
                            <td class="text-ink fw-medium">@n.Subject</td>
                            <td>
                                <span class="badge" style="background: @statusBg; color: @statusColor; font-weight: 500;">
                                    @n.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
