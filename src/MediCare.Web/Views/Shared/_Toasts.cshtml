@* _Toasts.cshtml — Renders TempData["Success"] and TempData["Error"] as Bootstrap toasts *@
@{
    var successMsg = TempData["Success"] as string;
    var errorMsg   = TempData["Error"]   as string;
}

@if (!string.IsNullOrEmpty(successMsg) || !string.IsNullOrEmpty(errorMsg))
{
    <div class="mc-toast-container" aria-live="polite" aria-atomic="true">
        @if (!string.IsNullOrEmpty(successMsg))
        {
            <div class="mc-toast mc-toast-success" role="alert">
                <div class="mc-toast-icon"><i class="bi bi-check-circle-fill"></i></div>
                <div class="mc-toast-body">@successMsg</div>
                <button type="button" class="mc-toast-close" aria-label="Close">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }
        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="mc-toast mc-toast-error" role="alert">
                <div class="mc-toast-icon"><i class="bi bi-exclamation-circle-fill"></i></div>
                <div class="mc-toast-body">@errorMsg</div>
                <button type="button" class="mc-toast-close" aria-label="Close">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }
    </div>

    <script>
        // Auto-dismiss toasts after 5 s
        document.querySelectorAll('.mc-toast').forEach(function (toast) {
            setTimeout(() => toast.style.opacity = '0', 4500);
            setTimeout(() => toast.remove(), 5000);
            toast.querySelector('.mc-toast-close')?.addEventListener('click', () => toast.remove());
        });
    </script>
}
