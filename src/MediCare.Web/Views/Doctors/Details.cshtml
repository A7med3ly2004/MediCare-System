@model MediCare.Web.ViewModels.Doctors.DoctorDetailsViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Dr. {Model.Doctor.FullName}";
    ViewData["ActiveNav"] = "doctors";
}

<div class="mc-page-container pb-5">
    <!-- Back to directory link (UI Match: Doctor profile.png) -->
    <div class="mb-3">
        <a asp-action="Index" class="mc-back-link">
            <i class="bi bi-arrow-left"></i> BACK TO DOCTORS
        </a>
    </div>

    <!-- Page Title Row -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
        <div>
            <h1 class="mc-page-title mb-1">Doctor profile</h1>
            <p class="mc-page-subtitle mb-0">Clinical expertise, practice details and appointment availability.</p>
        </div>
        <div>
            <span class="mc-text-secondary mc-fs-13 fw-medium">
                @DateTime.UtcNow.ToString("dddd, dd MMMM yyyy")
            </span>
        </div>
    </div>

    <!-- ═══ HERO CARD (UI Match: Doctor profile.png) ════════════════════════════ -->
    <div class="mc-card p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-start gap-4">
                <!-- Avatar / Photo (Square 88x88) -->
                @if (!string.IsNullOrEmpty(Model.Doctor.ProfileImage))
                {
                    <img src="@Model.Doctor.ProfileImage"
                         alt="@Model.Doctor.FullName"
                         class="mc-doctor-avatar mc-doctor-avatar--square shadow-sm" />
                }
                else
                {
                    <div class="mc-doctor-avatar mc-doctor-avatar--square shadow-sm">
                        @(Model.Doctor.FullName.Length > 0 ? Model.Doctor.FullName.Substring(0, 1).ToUpper() : "D")
                    </div>
                }

                <div>
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <h2 class="h4 fw-bold text-ink mb-0">Dr. @Model.Doctor.FullName</h2>
                        @if (Model.Doctor.IsAvailableToday)
                        {
                            <span class="mc-badge mc-badge--available">Available</span>
                        }
                        else
                        {
                            <span class="mc-badge mc-badge--off-duty">Off duty</span>
                        }
                    </div>
                    <p class="mc-text-primary fw-semibold mc-fs-14 mb-1">
                        Consultant @Model.Doctor.SpecializationName
                    </p>
                    <p class="mc-text-secondary mc-fs-13 mb-1">
                        Clinical Consultant · Al Nour Clinic Medical Staff
                    </p>
                    <p class="mc-text-secondary mc-fs-12 mb-0">
                        <i class="bi bi-geo-alt me-1"></i>Al Nour Clinic · @Model.Doctor.Location @(!string.IsNullOrEmpty(Model.Doctor.RoomNumber) ? $"· {Model.Doctor.RoomNumber}" : "")
                    </p>
                </div>
            </div>

            <!-- Consultation Fee & Action -->
            <div class="text-md-end mt-3 mt-md-0 pt-3 pt-md-0 border-top border-md-top-0 w-100 w-md-auto" style="border-color: var(--mc-hairline) !important;">
                <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Consultation fee</span>
                <span class="mc-fw-700 mc-text-ink fs-3 d-block mb-3">@Model.Doctor.ConsultationFee.ToString("N0") EGP</span>
                <a href="#availabilitySection" class="mc-btn mc-btn-primary px-3 w-100 w-md-auto">
                    <i class="bi bi-calendar-plus me-1"></i> Book appointment
                </a>
            </div>
        </div>
    </div>

    <!-- Secondary Navigation Tabs (UI Match: Doctor profile.png) -->
    <ul class="nav nav-tabs mb-4 border-bottom" style="border-color: var(--mc-hairline) !important;">
        <li class="nav-item">
            <a class="nav-link active fw-semibold text-ink" href="#overview">Overview</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-secondary" href="#schedule">Schedule</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-secondary" href="#about">About</a>
        </li>
    </ul>

    <!-- ═══ 2-COLUMN MAIN CONTENT ═══════════════════════════════════════════════ -->
    <div class="row g-4">
        <!-- ── Left Column (Wide) ──────────────────────────────────────────────── -->
        <div class="col-12 col-lg-7 col-xl-8">
            <!-- About Doctor Card -->
            <div class="mc-card p-4 mb-4" id="about">
                <h3 class="h6 fw-bold text-ink mb-3">About Dr. @Model.Doctor.FullName</h3>
                <p class="mc-text-secondary mc-fs-14 lh-base mb-4">
                    Dr. @Model.Doctor.FullName is a distinguished consultant in @Model.Doctor.SpecializationName at Al Nour Clinic.
                    Committed to providing comprehensive, evidence-based diagnostic and treatment services with personalized patient care.
                </p>

                <!-- Metadata 3-cols -->
                <div class="row g-3 py-3 border-top border-bottom mb-4" style="border-color: var(--mc-hairline) !important;">
                    <div class="col-4">
                        <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Specialty</span>
                        <span class="mc-text-ink mc-fs-14 fw-bold">@Model.Doctor.SpecializationName</span>
                    </div>
                    <div class="col-4">
                        <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Experience</span>
                        <span class="mc-text-ink mc-fs-14 fw-bold">10+ years</span>
                    </div>
                    <div class="col-4">
                        <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Languages</span>
                        <span class="mc-text-ink mc-fs-14 fw-bold">English, Arabic</span>
                    </div>
                </div>

                <!-- Clinical Focus -->
                <div>
                    <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-2">Clinical focus</span>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="mc-tag-pill">@Model.Doctor.SpecializationName</span>
                        <span class="mc-tag-pill">Clinical consultations</span>
                        <span class="mc-tag-pill">Diagnostic evaluations</span>
                        <span class="mc-tag-pill">Follow-up treatment</span>
                    </div>
                </div>
            </div>

            <!-- Weekly Schedule & Booking Slots (Task 5 Placeholder) -->
            <div class="mc-card p-4" id="schedule">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h6 fw-bold text-ink mb-0">Weekly Practice Schedule</h3>
                    <span class="badge" style="background-color: var(--mc-primary-light); color: var(--mc-confirmed-text); font-size: 11px;">
                        Recurring clinic hours
                    </span>
                </div>

                <!-- CLEARLY MARKED TASK 5 SECTION -->
                <div class="p-3 mb-4 rounded" style="background-color: var(--mc-primary-light); border: 1px dashed var(--mc-primary);">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle-fill text-primary mt-1"></i>
                        <div>
                            <strong class="mc-text-ink mc-fs-13">Appointment booking is coming in Task 5:</strong>
                            <p class="mc-text-secondary mc-fs-12 mb-0">
                                Real-time slot generation, conflict checking, and live appointment booking with email notifications will be activated here in Task 5.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Schedule Table -->
                @if (Model.Doctor.Schedules.Any())
                {
                    <div class="table-responsive">
                        <table class="table mc-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Day of Week</th>
                                    <th>Working Hours</th>
                                    <th>Consultation Slot</th>
                                    <th>Clinic Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sched in Model.Doctor.Schedules)
                                {
                                    <tr>
                                        <td>
                                            <strong class="text-ink">@sched.DayName</strong>
                                        </td>
                                        <td>
                                            <span class="text-secondary">
                                                @sched.StartTime.ToString(@"hh\:mm") – @sched.EndTime.ToString(@"hh\:mm")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="mc-text-secondary">@sched.SlotMinutes minutes</span>
                                        </td>
                                        <td>
                                            <span class="mc-badge mc-badge--available">Scheduled</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="mc-text-secondary mc-fs-13 mb-0">
                        No recurring weekly schedule has been registered yet for this doctor.
                    </p>
                }

                <!-- Vacation notices if any -->
                @if (Model.Doctor.VacationDates.Any())
                {
                    <div class="mt-4 pt-3 border-top" style="border-color: var(--mc-hairline) !important;">
                        <h4 class="h6 fw-bold text-ink mb-2">Upcoming Planned Leave</h4>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var vac in Model.Doctor.VacationDates)
                            {
                                <span class="badge bg-light text-secondary border">
                                    <i class="bi bi-calendar-x me-1"></i>@vac.ToString("ddd, dd MMM yyyy")
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- ── Right Column (Cards) ────────────────────────────────────────────── -->
        <div class="col-12 col-lg-5 col-xl-4">
            <!-- Availability Card (UI Match: Doctor profile.png) -->
            <div class="mc-card p-4 mb-4" id="availabilitySection">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h6 fw-bold text-ink mb-0">Availability</h3>
                    <span class="mc-text-secondary mc-fs-12">
                        @DateTime.UtcNow.ToString("MMM yyyy")
                    </span>
                </div>

                <!-- Week Day Pills -->
                <div class="d-flex justify-content-between gap-1 mb-4">
                    @{
                        var today = DateTime.UtcNow;
                        for (int i = 0; i < 6; i++)
                        {
                            var dt = today.AddDays(i);
                            var isSelected = dt.Date == Model.SelectedDate.ToDateTime(TimeOnly.MinValue).Date;
                            <div class="mc-day-pill @(isSelected ? "active" : "")">
                                <span class="mc-day-pill__day">@dt.ToString("ddd")[0]</span>
                                <span class="mc-day-pill__num">@dt.Day</span>
                            </div>
                        }
                    }
                </div>

                <!-- Consulting hours today -->
                <div class="mb-3">
                    <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Consulting hours today</span>
                    <span class="mc-text-ink mc-fs-13 fw-bold">
                        @Model.FormattedConsultingHours @(!string.IsNullOrEmpty(Model.Doctor.RoomNumber) ? $"· {Model.Doctor.RoomNumber}" : "")
                    </span>
                </div>

                <!-- Available Appointment Times (Task 5 Placeholder) -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold">Available appointment times</span>
                        <span class="badge" style="background-color: var(--mc-primary-light); color: var(--mc-confirmed-text); font-size: 10px;">
                            Task 5 Preview
                        </span>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button type="button" class="mc-slot-btn" disabled>10:00 AM</button>
                        <button type="button" class="mc-slot-btn active" disabled>11:30 AM</button>
                        <button type="button" class="mc-slot-btn" disabled>01:30 PM</button>
                        <button type="button" class="mc-slot-btn" disabled>02:30 PM</button>
                    </div>
                    <span class="mc-text-secondary mc-fs-11 d-block mb-3">
                        30-minute visits · In-clinic appointments
                    </span>

                    <button type="button" class="mc-btn mc-btn-primary w-100" disabled title="Booking will be implemented in Task 5">
                        Book selected time (Task 5)
                    </button>
                </div>

                <div class="border-top pt-3" style="border-color: var(--mc-hairline) !important;">
                    <p class="mc-text-secondary mc-fs-11 mb-0">
                        Regular clinic hours: Mon–Sat, 09:00 AM–06:00 PM. Friday by appointment.
                    </p>
                </div>
            </div>

            <!-- Contact Information Card (UI Match: Doctor profile.png) -->
            <div class="mc-card p-4">
                <h3 class="h6 fw-bold text-ink mb-3">Contact information</h3>

                <div class="mb-3">
                    <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Phone number</span>
                    <span class="mc-text-ink mc-fs-14 fw-medium">
                        @(string.IsNullOrEmpty(Model.Doctor.PhoneNumber) ? "+20 100 000 0000" : Model.Doctor.PhoneNumber)
                    </span>
                </div>

                <div class="mb-3">
                    <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Email address</span>
                    <span class="mc-text-ink mc-fs-14 fw-medium text-break">
                        @Model.Doctor.Email
                    </span>
                </div>

                <div class="mb-3">
                    <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Reception</span>
                    <span class="mc-text-ink mc-fs-14 fw-medium">
                        +20 2 2561 0340
                    </span>
                </div>

                @if (Model.CanEditProfile)
                {
                    <div class="pt-3 border-top mt-3" style="border-color: var(--mc-hairline) !important;">
                        <a asp-action="Edit" asp-route-id="@Model.Doctor.Id" class="mc-link fw-semibold mc-fs-13 text-decoration-none d-inline-flex align-items-center">
                            Edit doctor information <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
