@model MediCare.Web.ViewModels.MedicalRecords.PatientProfileViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Profile";
}

<div class="mc-page-container pb-5">
    <div class="mc-page-header mb-4">
        <h1 class="mc-page-title mb-1">My Profile</h1>
        <p class="mc-page-subtitle mb-0">Manage your contact information, allergies, and clinical care background.</p>
    </div>

    <!-- Account Identity Card (Read-only personal details) -->
    <div class="mc-card p-4 mb-4" style="background-color: #F8FBFE; border: 1px solid #D6EBF8;">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div style="width: 52px; height: 52px; background-color: var(--mc-primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 20px; color: var(--mc-ink);">
                    @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1) : "P")
                </div>
                <div>
                    <h2 class="h5 fw-bold text-ink mb-1">@Model.FullName</h2>
                    <span class="text-secondary small">
                        Patient Code: <strong class="text-ink">@Model.PatientCode</strong> · Age: @Model.Age years · DOB: @Model.DateOfBirth.ToString("dd MMM yyyy")
                    </span>
                </div>
            </div>
            <div>
                <span class="mc-badge mc-badge--completed">Active Patient</span>
            </div>
        </div>
    </div>

    <!-- Edit Profile Form -->
    <div class="mc-card p-4">
        <form asp-action="Profile" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PatientCode" />
            <input type="hidden" asp-for="FullName" />
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="DateOfBirth" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <h2 class="h6 fw-bold text-ink mb-3 pb-2 border-bottom">
                <i class="bi bi-person-lines-fill text-primary me-1"></i> Contact & Emergency Information
            </h2>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label class="mc-form-label">Email address (Account ID)</label>
                    <input type="email" value="@Model.Email" class="form-control mc-form-control bg-light" readonly />
                    <span class="text-secondary small">Primary account email used for clinic notices</span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="PhoneNumber" class="mc-form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control mc-form-control" placeholder="+20 100 123 4567" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
            </div>

            <h2 class="h6 fw-bold text-ink mb-3 pb-2 border-bottom">
                <i class="bi bi-heart-pulse text-primary me-1"></i> Health & Medical Care Background
            </h2>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <label asp-for="BloodGroup" class="mc-form-label"></label>
                    <select asp-for="BloodGroup" class="form-select mc-form-control">
                        <option value="">-- Select Blood Group --</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                    </select>
                    <span asp-validation-for="BloodGroup" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-8">
                    <label asp-for="Allergies" class="mc-form-label"></label>
                    <input asp-for="Allergies" class="form-control mc-form-control" placeholder="e.g. Penicillin, Sulfa drugs, Aspirin, Pollen (or leave blank if none)" />
                    <span class="text-secondary small">Known allergies help your doctors avoid unsafe prescriptions</span>
                    <span asp-validation-for="Allergies" class="text-danger small d-block"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="MedicalHistory" class="mc-form-label"></label>
                <textarea asp-for="MedicalHistory" class="form-control mc-form-control" rows="3" placeholder="e.g. Essential hypertension, Type 2 diabetes, Asthma, previous surgeries..."></textarea>
                <span class="text-secondary small">Document chronic conditions or past surgical history for clinic consultations</span>
                <span asp-validation-for="MedicalHistory" class="text-danger small d-block"></span>
            </div>

            <div class="pt-3 border-top d-flex align-items-center gap-2">
                <button type="submit" class="mc-btn mc-btn-primary px-4">
                    <i class="bi bi-check2 me-1"></i> Save Profile Changes
                </button>
                <a asp-action="Index" class="mc-btn mc-btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
