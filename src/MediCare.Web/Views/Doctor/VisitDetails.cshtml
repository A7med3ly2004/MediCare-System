@model MediCare.Services.MedicalRecords.MedicalRecordDetailDto
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Visit Record — {Model.PatientName}";
}

<div class="mc-page-container pb-5">
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <a asp-action="Index" class="text-secondary small text-decoration-none fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> BACK TO DASHBOARD
        </a>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="RecordVisit" asp-route-appointmentId="@Model.AppointmentId" class="mc-btn mc-btn-secondary mc-btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit record
            </a>
            @if (Model.Prescriptions.Any())
            {
                <a asp-controller="Prescription" asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="mc-btn mc-btn-primary mc-btn-sm">
                    <i class="bi bi-printer me-1"></i> Print prescription
                </a>
            }
        </div>
    </div>

    <!-- Record Header Card -->
    <div class="mc-card p-4 mb-4" style="background-color: #F8FBFE; border: 1px solid #D6EBF8;">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <span class="mc-badge mc-badge--completed mb-2 d-inline-block">Completed Visit</span>
                <h1 class="h4 fw-bold text-ink mb-1">@Model.Diagnosis</h1>
                <p class="text-secondary small mb-0">
                    Consultation on @Model.AppointmentDate.ToString("dddd, dd MMMM yyyy") at @Model.FormattedTime · Room @(string.IsNullOrEmpty(Model.RoomNumber) ? "02" : Model.RoomNumber)
                </p>
            </div>
            <div class="text-md-end">
                <strong class="d-block text-ink">@Model.PatientName</strong>
                <span class="text-secondary small">@Model.PatientCode · @Model.Age years · DOB: @Model.DateOfBirth.ToString("dd MMM yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row g-4">
        <!-- Vitals & Notes (Left) -->
        <div class="col-12 col-xl-8">
            <!-- Vitals Row -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6">
                    <div class="mc-card p-3">
                        <span class="text-secondary small d-block mb-1">Blood pressure</span>
                        <div class="h5 fw-bold text-ink mb-0">
                            @(string.IsNullOrEmpty(Model.BloodPressure) ? "Not recorded" : Model.BloodPressure)
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <div class="mc-card p-3">
                        <span class="text-secondary small d-block mb-1">Heart rate</span>
                        <div class="h5 fw-bold text-ink mb-0">
                            @(Model.HeartRate.HasValue ? $"{Model.HeartRate} bpm" : "Not recorded")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Clinical Details -->
            <div class="mc-card p-4 mb-4">
                <h2 class="h6 fw-bold text-ink mb-3 pb-2 border-bottom">Clinical Findings & Diagnosis</h2>

                <div class="mb-3">
                    <span class="text-secondary small d-block mb-1">Presenting symptoms & complaint:</span>
                    <p class="text-ink small mb-0">
                        @(string.IsNullOrEmpty(Model.Symptoms) ? "No presenting symptoms documented." : Model.Symptoms)
                    </p>
                </div>

                <div class="mb-3">
                    <span class="text-secondary small d-block mb-1">Diagnosis:</span>
                    <strong class="text-ink small">@Model.Diagnosis</strong>
                </div>

                <div>
                    <span class="text-secondary small d-block mb-1">Treatment notes & recommendations:</span>
                    <p class="text-ink small mb-0">
                        @(string.IsNullOrEmpty(Model.TreatmentNotes) ? "No treatment notes documented." : Model.TreatmentNotes)
                    </p>
                </div>
            </div>

            <!-- Digital Prescription -->
            <div class="mc-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h2 class="h6 fw-bold text-ink mb-0">
                        <i class="bi bi-capsule text-primary me-1"></i> Digital Prescription
                    </h2>
                    @if (Model.Prescriptions.Any())
                    {
                        <a asp-controller="Prescription" asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="mc-btn mc-btn-primary mc-btn-sm">
                            <i class="bi bi-printer me-1"></i> Print
                        </a>
                    }
                </div>

                @if (!Model.Prescriptions.Any())
                {
                    <p class="text-secondary small mb-0">No prescription medications were issued during this visit.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mc-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Medication</th>
                                    <th>Dosage</th>
                                    <th>Frequency</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Prescriptions.Count; i++)
                                {
                                    var item = Model.Prescriptions[i];
                                    <tr>
                                        <td class="text-secondary small">@(i + 1)</td>
                                        <td><strong class="text-ink">@item.Medication</strong></td>
                                        <td>@item.Dosage</td>
                                        <td>@item.Frequency</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Right Side: Patient Care Alerts -->
        <div class="col-12 col-xl-4">
            <div class="mc-card p-4 mb-4">
                <h3 class="h6 fw-bold text-ink mb-3">Patient Care Information</h3>

                <div class="mb-3">
                    <span class="text-secondary small d-block">Blood group</span>
                    <strong class="text-ink small">@(string.IsNullOrEmpty(Model.BloodGroup) ? "Not recorded" : Model.BloodGroup)</strong>
                </div>

                @if (!string.IsNullOrEmpty(Model.Allergies))
                {
                    <div class="p-3 rounded mb-3" style="background-color: #FFF3E0; border: 1px solid #FFE0B2; color: #E65100; font-size: 13px;">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>Allergy Alert:</strong> @Model.Allergies
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.MedicalHistory))
                {
                    <div class="mb-3">
                        <span class="text-secondary small d-block">Chronic conditions & history</span>
                        <strong class="text-ink small">@Model.MedicalHistory</strong>
                    </div>
                }

                <div class="pt-3 border-top">
                    <a asp-action="PatientProfile" asp-route-id="@Model.PatientId" class="mc-btn mc-btn-secondary w-100">
                        <i class="bi bi-person me-1"></i> Open full patient record
                    </a>
                </div>
            </div>

            <div class="mc-card p-3 text-secondary small">
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span>Record created</span>
                    <strong class="text-ink">@Model.CreatedAt.ToString("g")</strong>
                </div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <div class="d-flex justify-content-between py-1">
                        <span>Last modified</span>
                        <strong class="text-ink">@Model.UpdatedAt.Value.ToString("g")</strong>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
