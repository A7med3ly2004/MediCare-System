@model MediCare.Web.ViewModels.Account.RegisterDoctorViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Doctor Registration";
}

<div class="mc-auth-card" style="max-width: 660px;">
    <div class="text-center mb-4">
        <a asp-controller="Home" asp-action="Index" class="mc-auth-logo justify-content-center">
            <img src="~/images/logo.png" alt="MediCare" class="mc-auth-logo-icon" />
            <span>MediCare</span>
        </a>
        <h1 class="mc-auth-title mt-2">Doctor Registration</h1>
        <p class="mc-auth-subtitle">Join the medical staff at Al Nour Clinic</p>
    </div>

    @await Html.PartialAsync("_ValidationSummary")

    <form asp-controller="Account" asp-action="RegisterDoctor" method="post" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="FullName" class="mc-form-label">
                        Full name <span class="required">*</span>
                    </label>
                    <input asp-for="FullName" class="form-control mc-input" placeholder="e.g. Dr. Mariam Ahmed" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="Email" class="mc-form-label">
                        Email address <span class="required">*</span>
                    </label>
                    <input asp-for="Email" class="form-control mc-input" type="email" placeholder="doctor@medicare.eg" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="Password" class="mc-form-label">
                        Password <span class="required">*</span>
                    </label>
                    <input asp-for="Password" class="form-control mc-input" type="password" placeholder="At least 8 characters" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="ConfirmPassword" class="mc-form-label">
                        Confirm password <span class="required">*</span>
                    </label>
                    <input asp-for="ConfirmPassword" class="form-control mc-input" type="password" placeholder="Re-enter password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="SpecializationId" class="mc-form-label">
                        Specialization <span class="required">*</span>
                    </label>
                    <select asp-for="SpecializationId" asp-items="Model.Specializations" class="form-select mc-input">
                        <option value="">-- Select Medical Specialization --</option>
                    </select>
                    <span asp-validation-for="SpecializationId" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="Location" class="mc-form-label">
                        Clinic location / City <span class="required">*</span>
                    </label>
                    <input asp-for="Location" class="form-control mc-input" placeholder="e.g. New Cairo Clinic, Cairo" />
                    <span asp-validation-for="Location" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="ConsultationFee" class="mc-form-label">
                        Consultation fee (EGP) <span class="required">*</span>
                    </label>
                    <input asp-for="ConsultationFee" class="form-control mc-input" type="number" step="10" min="0" placeholder="500" />
                    <span asp-validation-for="ConsultationFee" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="RoomNumber" class="mc-form-label">
                        Room number
                    </label>
                    <input asp-for="RoomNumber" class="form-control mc-input" placeholder="e.g. Room 02" />
                    <span asp-validation-for="RoomNumber" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>

        <div class="mc-form-group mb-3">
            <label asp-for="ProfileImage" class="mc-form-label">
                Profile photo <span class="text-secondary small fw-normal">(Optional — JPG, PNG, WebP up to 2MB)</span>
            </label>
            <input asp-for="ProfileImage" class="form-control mc-input" type="file" accept=".jpg,.jpeg,.png,.webp" />
            <span asp-validation-for="ProfileImage" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="AcceptedPrivacyNotice" class="form-check-input" type="checkbox" id="privacyNoticeDoctor" />
            <label asp-for="AcceptedPrivacyNotice" class="form-check-label text-secondary small" for="privacyNoticeDoctor">
                I agree to the <a href="#" class="text-primary">Clinical Practitioner Policy</a> and <a href="#" class="text-primary">Terms of Service</a>. <span class="required">*</span>
            </label>
            <span asp-validation-for="AcceptedPrivacyNotice" class="text-danger small mt-1 d-block"></span>
        </div>

        <button type="submit" class="mc-btn mc-btn-primary w-100 py-2 mb-3">
            Submit Doctor Registration
        </button>

        <div class="mc-auth-footer">
            Already have a doctor account?
            <a asp-controller="Account" asp-action="Login" class="fw-semibold ms-1">Sign in here</a>
        </div>
    </form>
</div>
