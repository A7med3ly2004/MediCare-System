@model MediCare.Web.ViewModels.Doctors.DoctorIndexViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Our Doctors";
    ViewData["ActiveNav"] = "doctors";
}

<div class="mc-page-container pb-5">
    <!-- ═══ HEADER ROW (UI Match: Doctors directory.png) ═══════════════════════ -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
        <div>
            <h1 class="mc-page-title mb-1">Our doctors</h1>
            <p class="mc-page-subtitle mb-0">A trusted care team, with the right expertise for every patient.</p>
        </div>
        <div class="text-md-end">
            <span class="mc-text-secondary mc-fs-13 fw-medium">
                @DateTime.UtcNow.ToString("dddd, dd MMMM yyyy")
            </span>
        </div>
    </div>

    <!-- ═══ SUB-STATS ROW ═════════════════════════════════════════════════════ -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 py-2 mb-4 border-top border-bottom" style="border-color: var(--mc-hairline) !important;">
        <div class="d-flex align-items-center gap-3 mc-text-secondary mc-fs-13">
            <span><strong class="mc-text-ink">@Model.Stats.TotalDoctors</strong> doctors</span>
            <span>·</span>
            <span><strong class="mc-text-ink">@Model.Stats.AvailableTodayCount</strong> available today</span>
            <span>·</span>
            <span><strong class="mc-text-ink">@Model.Stats.SpecialtiesCount</strong> specialties</span>
        </div>
        <div class="mc-text-secondary mc-fs-13">
            <span>Clinic hours · Mon–Sat, 09:00 AM–06:00 PM</span>
        </div>
    </div>

    <!-- ═══ FILTER BAR (UI Match: Doctors directory.png) ══════════════════════ -->
    <div class="mc-card p-3 mb-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <!-- Search Text Input -->
            <div class="col-12 col-md-4">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary"></i>
                    <input type="text"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="form-control ps-5"
                           placeholder="Search doctors or specialty…"
                           aria-label="Search doctors" />
                </div>
            </div>

            <!-- Specialization Dropdown -->
            <div class="col-12 col-sm-6 col-md-3">
                <select name="specializationId" class="form-select" aria-label="Specialization">
                    <option value="">All specialties</option>
                    @foreach (var spec in Model.Specializations)
                    {
                        if (Model.SpecializationId?.ToString() == spec.Value)
                        {
                            <option value="@spec.Value" selected>@spec.Text</option>
                        }
                        else
                        {
                            <option value="@spec.Value">@spec.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- Availability Date Picker -->
            <div class="col-12 col-sm-6 col-md-3">
                <div class="position-relative">
                    <input type="date"
                           name="availableOn"
                           value="@(Model.AvailableOn?.ToString("yyyy-MM-dd"))"
                           class="form-control"
                           title="Select date to check availability"
                           aria-label="Availability date" />
                </div>
            </div>

            <!-- Actions -->
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="mc-btn mc-btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                @if (Model.HasActiveFilters)
                {
                    <a asp-action="Index" class="mc-btn mc-btn-secondary" title="Clear all filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Active Filter Chips (if any) -->
    @if (Model.HasActiveFilters)
    {
        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
            <span class="mc-text-secondary mc-fs-12">Active filters:</span>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <span class="mc-tag-pill">
                    Keyword: "@Model.SearchTerm"
                </span>
            }
            @if (Model.SpecializationId.HasValue)
            {
                var specName = Model.Specializations.FirstOrDefault(s => s.Value == Model.SpecializationId.Value.ToString())?.Text ?? "Selected specialty";
                <span class="mc-tag-pill">
                    Specialty: @specName
                </span>
            }
            @if (Model.AvailableOn.HasValue)
            {
                <span class="mc-tag-pill">
                    Date: @Model.AvailableOn.Value.ToString("ddd, dd MMM yyyy")
                </span>
            }
            <a asp-action="Index" class="mc-fs-12 mc-text-primary text-decoration-none ms-2">Reset all</a>
        </div>
    }

    <!-- ═══ DOCTORS GRID ═══════════════════════════════════════════════════════ -->
    @if (Model.Doctors.Items.Any())
    {
        <div class="row g-4 mb-4">
            @foreach (var doc in Model.Doctors.Items)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="mc-doctor-card h-100 d-flex flex-column justify-content-between">
                        <div>
                            <!-- Header: Avatar + Name + Specialization + Location -->
                            <div class="d-flex align-items-start gap-3 mb-3">
                                @if (!string.IsNullOrEmpty(doc.ProfileImage))
                                {
                                    <img src="@doc.ProfileImage"
                                         alt="@doc.FullName"
                                         class="mc-doctor-avatar" />
                                }
                                else
                                {
                                    <div class="mc-doctor-avatar">
                                        @(doc.FullName.Length > 0 ? doc.FullName.Substring(0, 1).ToUpper() : "D")
                                    </div>
                                }
                                <div class="overflow-hidden">
                                    <h2 class="h6 fw-bold text-ink mb-1 text-truncate" title="@doc.FullName">@doc.FullName</h2>
                                    <p class="mc-text-secondary mc-fs-13 mb-1 text-truncate">@doc.SpecializationName</p>
                                    <p class="mc-text-secondary mc-fs-12 mb-0 text-truncate">
                                        <i class="bi bi-geo-alt me-1"></i>@doc.Location @(!string.IsNullOrEmpty(doc.RoomNumber) ? $"· {doc.RoomNumber}" : "")
                                    </p>
                                </div>
                            </div>

                            <!-- Availability & Fee Row -->
                            <div class="d-flex justify-content-between align-items-center mb-3 pt-2 pb-2 border-top border-bottom" style="border-color: var(--mc-hairline) !important;">
                                <div>
                                    @if (doc.IsAvailableOnFilterDate)
                                    {
                                        <span class="mc-badge mc-badge--available">Available</span>
                                    }
                                    else
                                    {
                                        <span class="mc-badge mc-badge--off-duty">Off duty</span>
                                    }
                                </div>
                                <div>
                                    <span class="mc-fw-700 mc-text-ink fs-6">@doc.ConsultationFee.ToString("N0") EGP</span>
                                </div>
                            </div>

                            <!-- Metadata: Consulting Hours, Phone, Email -->
                            <div class="mb-4">
                                <div class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold mb-1">Consulting hours</div>
                                <div class="mc-text-ink mc-fs-13 fw-medium mb-2">@doc.ConsultingHoursSummary</div>

                                <div class="mc-text-secondary mc-fs-12 mb-1 text-truncate">
                                    <i class="bi bi-telephone me-2"></i>@(string.IsNullOrEmpty(doc.PhoneNumber) ? "+20 100 000 0000" : doc.PhoneNumber)
                                </div>
                                <div class="mc-text-secondary mc-fs-12 text-truncate">
                                    <i class="bi bi-envelope me-2"></i>@doc.Email
                                </div>
                            </div>
                        </div>

                        <!-- Card Action Buttons -->
                        <div class="d-flex gap-2 pt-2">
                            <a asp-action="Details" asp-route-id="@doc.Id" class="mc-btn mc-btn-secondary flex-fill text-center">
                                View profile
                            </a>
                            <a asp-action="Details" asp-route-id="@doc.Id" class="mc-btn mc-btn-primary flex-fill text-center">
                                View schedule
                            </a>
                        </div>
                    </div>
                </div>
            }

            <!-- UI Promo Card (matching UI/Doctors directory.png 6th slot) -->
            @if (Model.Doctors.Items.Count < 6)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="mc-promo-card h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="mb-3 text-primary fs-3"><i class="bi bi-calendar-check"></i></div>
                            <h3 class="h5 fw-bold text-ink mb-2">Good care starts with a well-planned day.</h3>
                            <p class="mc-text-secondary mc-fs-13 mb-4">
                                Manage consultation hours, leave and appointment capacity in one shared clinic schedule.
                            </p>
                        </div>
                        <div>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="Schedule" class="mc-link fw-semibold mc-fs-13 text-decoration-none">
                                    Manage doctor schedules <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            }
                            else if (User.IsInRole("Doctor"))
                            {
                                <a asp-controller="Doctor" asp-action="Schedule" class="mc-link fw-semibold mc-fs-13 text-decoration-none">
                                    Manage my schedule <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            }
                            else
                            {
                                <span class="mc-text-secondary mc-fs-13">Clinic appointments open Mon–Sat</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- ═══ PAGINATION CONTROLS ════════════════════════════════════════════ -->
        @if (Model.Doctors.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top" style="border-color: var(--mc-hairline) !important;">
                <span class="mc-text-secondary mc-fs-13">
                    Showing @(((Model.Doctors.Page - 1) * Model.Doctors.PageSize) + 1) to @(Math.Min(Model.Doctors.Page * Model.Doctors.PageSize, Model.Doctors.TotalCount)) of @Model.Doctors.TotalCount doctors
                </span>
                <nav aria-label="Doctors pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Doctors.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.Doctors.Page - 1)"
                               asp-route-specializationId="@Model.SpecializationId"
                               asp-route-locationKeyword="@Model.LocationKeyword"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-availableOn="@Model.AvailableOn?.ToString("yyyy-MM-dd")">
                                Previous
                            </a>
                        </li>
                        @for (int p = 1; p <= Model.Doctors.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Doctors.Page ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-specializationId="@Model.SpecializationId"
                                   asp-route-locationKeyword="@Model.LocationKeyword"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-availableOn="@Model.AvailableOn?.ToString("yyyy-MM-dd")">
                                    @p
                                </a>
                            </li>
                        }
                        <li class="page-item @(Model.Doctors.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.Doctors.Page + 1)"
                               asp-route-specializationId="@Model.SpecializationId"
                               asp-route-locationKeyword="@Model.LocationKeyword"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-availableOn="@Model.AvailableOn?.ToString("yyyy-MM-dd")">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <!-- ═══ EMPTY STATE ════════════════════════════════════════════════════ -->
        <div class="mc-card p-5 text-center my-4">
            <div class="mb-3">
                <i class="bi bi-person-x fs-1 text-secondary"></i>
            </div>
            <h3 class="h5 fw-bold text-ink mb-2">No doctors match your search</h3>
            <p class="mc-text-secondary mc-fs-13 mb-4 mx-auto" style="max-width: 420px;">
                We couldn't find any certified doctors matching the criteria you selected. Try adjusting your filters or search keywords.
            </p>
            <div>
                <a asp-action="Index" class="mc-btn mc-btn-primary">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Clear all filters
                </a>
            </div>
        </div>
    }
</div>
