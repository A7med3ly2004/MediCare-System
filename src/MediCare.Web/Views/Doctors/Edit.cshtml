@model MediCare.Web.ViewModels.Doctors.DoctorEditProfileViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Doctor Profile";
    ViewData["ActiveNav"] = "settings";
}

<div class="mc-page-container pb-5" style="max-width: 860px;">
    <!-- Back to profile link -->
    <div class="mb-3">
        <a asp-action="Details" asp-route-id="@Model.DoctorId" class="mc-back-link">
            <i class="bi bi-arrow-left"></i> BACK TO PROFILE
        </a>
    </div>

    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="mc-page-title mb-1">Edit Doctor Profile</h1>
        <p class="mc-page-subtitle mb-0">Update your clinical details, consultation fees, and public profile image.</p>
    </div>

    <div class="mc-card p-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="DoctorId" />
            <input type="hidden" asp-for="UserId" />

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4" role="alert"></div>

            <!-- Profile Photo Section -->
            <div class="mb-4 pb-4 border-bottom" style="border-color: var(--mc-hairline) !important;">
                <label class="form-label d-block fw-bold text-ink">Profile Photo</label>
                <div class="d-flex align-items-center gap-4 flex-wrap">
                    @if (!string.IsNullOrEmpty(Model.CurrentProfileImage))
                    {
                        <img src="@Model.CurrentProfileImage"
                             alt="@Model.FullName"
                             class="mc-doctor-avatar mc-doctor-avatar--square" />
                    }
                    else
                    {
                        <div class="mc-doctor-avatar mc-doctor-avatar--square">
                            @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1).ToUpper() : "D")
                        </div>
                    }

                    <div class="flex-grow-1" style="min-width: 260px;">
                        <input asp-for="ProfileImage"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp" />
                        <span asp-validation-for="ProfileImage" class="invalid-feedback d-block"></span>
                        <span class="mc-text-secondary mc-fs-12 mt-1 d-block">
                            Upload JPG, PNG, or WebP. Maximum file size: 2MB.
                        </span>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <!-- Full Name -->
                <div class="col-12 col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" placeholder="Dr. Full Name" />
                    <span asp-validation-for="FullName" class="invalid-feedback d-block"></span>
                </div>

                <!-- Phone Number -->
                <div class="col-12 col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="+20 100 000 0000" />
                    <span asp-validation-for="PhoneNumber" class="invalid-feedback d-block"></span>
                </div>

                <!-- Specialization -->
                <div class="col-12 col-md-6">
                    <label asp-for="SpecializationId" class="form-label"></label>
                    <select asp-for="SpecializationId" asp-items="Model.Specializations" class="form-select">
                        <option value="">Select Specialization…</option>
                    </select>
                    <span asp-validation-for="SpecializationId" class="invalid-feedback d-block"></span>
                </div>

                <!-- Location -->
                <div class="col-12 col-md-6">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. Building B, Clinic Wing" />
                    <span asp-validation-for="Location" class="invalid-feedback d-block"></span>
                </div>

                <!-- Consultation Fee -->
                <div class="col-12 col-md-6">
                    <label asp-for="ConsultationFee" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="ConsultationFee"
                               type="number"
                               step="10"
                               min="0"
                               class="form-control"
                               placeholder="500" />
                        <span class="input-group-text" style="background: var(--mc-canvas); border-color: var(--mc-hairline); font-size: 13px;">EGP</span>
                    </div>
                    <span asp-validation-for="ConsultationFee" class="invalid-feedback d-block"></span>
                </div>

                <!-- Room Number -->
                <div class="col-12 col-md-6">
                    <label asp-for="RoomNumber" class="form-label"></label>
                    <input asp-for="RoomNumber" class="form-control" placeholder="e.g. Room 204" />
                    <span asp-validation-for="RoomNumber" class="invalid-feedback d-block"></span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex align-items-center gap-2 pt-3 border-top" style="border-color: var(--mc-hairline) !important;">
                <button type="submit" class="mc-btn mc-btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i> Save Changes
                </button>
                <a asp-action="Details" asp-route-id="@Model.DoctorId" class="mc-btn mc-btn-secondary px-3">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
