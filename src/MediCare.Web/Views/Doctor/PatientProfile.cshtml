@model MediCare.Services.MedicalRecords.PatientMedicalProfileDto
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Patient Record — {Model.PatientName}";
    var initials = !string.IsNullOrEmpty(Model.PatientName)
        ? string.Join("", Model.PatientName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpperInvariant()
        : "PT";
}

<div class="mc-page-container pb-5">
    <!-- Breadcrumb & Back -->
    <div class="mb-3">
        <a asp-action="Patients" class="text-secondary small text-decoration-none fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> BACK TO PATIENTS
        </a>
    </div>

    <!-- Header -->
    <div class="mc-page-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="mc-page-title mb-1">Patient record</h1>
                <p class="mc-page-subtitle mb-0">A complete view of contact details, appointments and care history.</p>
            </div>
            <div class="text-secondary small">
                @DateTime.Today.ToString("dddd, dd MMMM yyyy")
            </div>
        </div>
    </div>

    <!-- ═══ Patient Identity Card (UI Match: Patient profile.png) ═══ -->
    <div class="mc-card p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div style="width: 56px; height: 56px; background-color: var(--mc-primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 20px; color: var(--mc-ink);">
                    @initials
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="h5 fw-bold text-ink mb-0">@Model.PatientName</h2>
                        <span class="mc-badge mc-badge--completed">Active</span>
                    </div>
                    <p class="text-secondary small mb-0">
                        @Model.PatientCode · @Model.Age years · Date of birth: @Model.DateOfBirth.ToString("dd MMM yyyy")
                    </p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                @if (Model.NextAppointment != null && Model.NextAppointment.Status == MediCare.Data.Entities.AppointmentStatus.Confirmed)
                {
                    <a asp-action="RecordVisit" asp-route-appointmentId="@Model.NextAppointment.Id" class="mc-btn mc-btn-primary">
                        <i class="bi bi-file-earmark-medical me-1"></i> Record visit
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- ═══ Main 2-Column Content (UI Match: Patient profile.png) ═══ -->
    <div class="row g-4">
        <!-- ── Left Column: Personal & Care Info ── -->
        <div class="col-12 col-xl-4">
            <!-- Personal Information -->
            <div class="mc-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h6 fw-bold text-ink mb-0">Personal information</h3>
                </div>

                <div class="row g-3 small">
                    <div class="col-6">
                        <span class="text-secondary d-block">Date of birth</span>
                        <strong class="text-ink">@Model.DateOfBirth.ToString("dd MMM yyyy")</strong>
                    </div>
                    <div class="col-6">
                        <span class="text-secondary d-block">Blood group</span>
                        <strong class="text-ink">@(string.IsNullOrEmpty(Model.BloodGroup) ? "Not recorded" : Model.BloodGroup)</strong>
                    </div>
                    <div class="col-12">
                        <span class="text-secondary d-block">Mobile number</span>
                        <strong class="text-ink">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</strong>
                    </div>
                    <div class="col-12">
                        <span class="text-secondary d-block">Email address</span>
                        <span class="text-ink">@(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)</span>
                    </div>
                </div>
            </div>

            <!-- Care Information (Allergies & Chronic History) -->
            <div class="mc-card p-4">
                <h3 class="h6 fw-bold text-ink mb-3">Care information</h3>

                <div class="mb-3">
                    <span class="text-secondary small d-block mb-1">Known condition / Medical history</span>
                    <strong class="text-ink small">
                        @(string.IsNullOrEmpty(Model.MedicalHistory) ? "No chronic conditions reported." : Model.MedicalHistory)
                    </strong>
                </div>

                @if (!string.IsNullOrEmpty(Model.Allergies))
                {
                    <div class="p-3 rounded mb-3" style="background-color: #FFF3E0; border: 1px solid #FFE0B2; color: #E65100; font-size: 13px;">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>Allergy Alert:</strong> @Model.Allergies
                    </div>
                }
                else
                {
                    <div class="p-2 rounded mb-3 text-secondary small" style="background-color: var(--mc-canvas); border: 1px solid var(--mc-hairline);">
                        <i class="bi bi-shield-check me-1 text-success"></i> No drug allergies on file
                    </div>
                }
            </div>
        </div>

        <!-- ── Right Column: Next Appointment & Clinical Records ── -->
        <div class="col-12 col-xl-8">
            <!-- Next Appointment Card (if any) -->
            @if (Model.NextAppointment != null)
            {
                var next = Model.NextAppointment;
                <div class="mc-card p-4 mb-4" style="background-color: #F8FBFE; border: 1px solid #D6EBF8;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="small text-uppercase fw-bold text-secondary">Upcoming Consultation</span>
                        @if (next.Status == MediCare.Data.Entities.AppointmentStatus.Confirmed)
                        {
                            <span class="mc-badge mc-badge--confirmed">Confirmed</span>
                        }
                        else
                        {
                            <span class="mc-badge mc-badge--pending">Pending</span>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h4 class="h5 fw-bold text-ink mb-1">
                                @next.AppointmentDate.ToString("dddd, dd MMMM yyyy") at @next.StartTime.ToString(@"hh\:mm")
                            </h4>
                            <span class="text-secondary small">
                                @DoctorNameFormatter.Format(next.DoctorName) · Room @(string.IsNullOrEmpty(next.RoomNumber) ? "02" : next.RoomNumber) · @(!string.IsNullOrEmpty(next.Notes) ? next.Notes : "Consultation")
                            </span>
                        </div>
                        @if (next.Status == MediCare.Data.Entities.AppointmentStatus.Confirmed)
                        {
                            <a asp-action="RecordVisit" asp-route-appointmentId="@next.Id" class="mc-btn mc-btn-primary">
                                <i class="bi bi-file-earmark-medical me-1"></i> Record visit
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Recent Medical Records -->
            <div class="mc-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h6 fw-bold text-ink mb-0">Clinical Consultation History</h3>
                    <span class="text-secondary small">@Model.MedicalRecords.Count visits recorded</span>
                </div>

                @if (!Model.MedicalRecords.Any())
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="bi bi-clipboard2-pulse fs-1 d-block mb-2 text-muted"></i>
                        <p class="mb-0 fw-semibold">No medical records on file yet.</p>
                        <span class="small">Clinical notes and prescriptions will appear here once recorded.</span>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var rec in Model.MedicalRecords)
                        {
                            <div class="p-3 rounded border" style="background-color: var(--mc-surface); border-color: var(--mc-hairline) !important;">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <i class="bi bi-file-text text-primary"></i>
                                            <strong class="text-ink">@rec.Diagnosis</strong>
                                            @if (rec.UpdatedAt.HasValue)
                                            {
                                                <span class="badge border" style="background: var(--mc-canvas); color: var(--mc-secondary-text); border-color: var(--mc-hairline) !important;" title="Edited on @rec.UpdatedAt.Value.ToString("g")">Edited</span>
                                            }
                                        </div>
                                        <span class="text-secondary small">
                                            @rec.AppointmentDate.ToString("dd MMM yyyy") at @rec.FormattedTime · @DoctorNameFormatter.Format(rec.DoctorName) (@rec.DoctorSpecialization)
                                        </span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <a asp-action="VisitDetails" asp-route-id="@rec.Id" class="mc-btn mc-btn-secondary mc-btn-sm">
                                            View details
                                        </a>
                                        @if (rec.Prescriptions.Any())
                                        {
                                            <a asp-controller="Prescription" asp-action="Print" asp-route-id="@rec.Id" target="_blank" class="mc-btn mc-btn-secondary mc-btn-sm">
                                                <i class="bi bi-printer"></i>
                                            </a>
                                        }
                                    </div>
                                </div>

                                <div class="row g-2 small text-secondary mb-2 pt-2 border-top">
                                    <div class="col-sm-6">
                                        <span>Blood pressure: </span><strong class="text-ink">@(rec.BloodPressure ?? "Not recorded")</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span>Heart rate: </span><strong class="text-ink">@(rec.HeartRate.HasValue ? $"{rec.HeartRate} bpm" : "Not recorded")</strong>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(rec.TreatmentNotes))
                                {
                                    <p class="small text-secondary mb-2">
                                        <strong class="text-ink">Treatment notes: </strong>@rec.TreatmentNotes
                                    </p>
                                }

                                @if (rec.Prescriptions.Any())
                                {
                                    <div class="pt-2 border-top small">
                                        <span class="fw-semibold text-ink d-block mb-1">Prescription (@rec.Prescriptions.Count medications):</span>
                                        <ul class="mb-0 ps-3 text-secondary">
                                            @foreach (var med in rec.Prescriptions)
                                            {
                                                <li><strong>@med.Medication</strong> — @med.Dosage, @med.Frequency</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
