@model MediCare.Services.MedicalRecords.MedicalRecordDetailDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prescription — @Model.PatientName — MediCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #F7F9FA;
            color: #253747;
            padding: 30px 15px;
        }

        .prescription-container {
            max-width: 800px;
            margin: 0 auto;
            background: #ffffff;
            border: 1px solid #E2EBEC;
            border-radius: 8px;
            padding: 48px;
            box-shadow: 0 4px 16px rgba(37, 55, 71, 0.08);
        }

        .clinic-brand {
            font-size: 24px;
            font-weight: 700;
            color: #253747;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .clinic-logo-icon {
            width: 32px;
            height: 32px;
            background-color: #90D0F2;
            color: #253747;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            font-weight: bold;
            font-size: 18px;
        }

        .rx-symbol {
            font-size: 38px;
            font-family: 'Times New Roman', serif;
            font-style: italic;
            font-weight: bold;
            color: #253747;
            line-height: 1;
        }

        .table-prescription th {
            background-color: #F7F9FA;
            border-bottom: 2px solid #E2EBEC;
            font-weight: 600;
            font-size: 13px;
            color: #607280;
            text-transform: uppercase;
            padding: 12px 14px;
        }

        .table-prescription td {
            padding: 14px;
            border-bottom: 1px solid #E2EBEC;
            vertical-align: middle;
        }

        .signature-line {
            width: 240px;
            border-top: 1px solid #253747;
            margin-top: 60px;
            text-align: center;
            padding-top: 8px;
            font-size: 13px;
        }

        @@media print {
            body {
                background: #ffffff !important;
                padding: 0 !important;
            }

            .no-print {
                display: none !important;
            }

            .prescription-container {
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
                max-width: 100% !important;
            }
        }
    </style>
</head>
<body>
    <!-- Top Print Control Bar (Hidden on print) -->
    <div class="container mb-4 no-print" style="max-width: 800px;">
        <div class="d-flex justify-content-between align-items-center p-3 rounded border shadow-sm" style="background: var(--mc-surface); border-color: var(--mc-hairline) !important;">
            <div>
                <strong class="d-block text-ink">Prescription Preview</strong>
                <span class="text-secondary small">Ready for printing or PDF export</span>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary px-4 fw-semibold" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print Prescription
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="window.close()">
                    Close
                </button>
            </div>
        </div>
    </div>

    <!-- Official Prescription Sheet -->
    <div class="prescription-container">
        <!-- Clinic Letterhead Header -->
        <div class="d-flex justify-content-between align-items-start pb-4 border-bottom mb-4">
            <div>
                <div class="clinic-brand mb-1">
                    <span class="clinic-logo-icon">+</span> MediCare
                </div>
                <span class="text-secondary small d-block">Al Nour Medical Clinic · Cairo, Egypt</span>
                <span class="text-secondary small d-block">Tel: +20 (02) 2345 6789 · info@medicare.eg</span>
            </div>
            <div class="text-end">
                <h2 class="h5 fw-bold text-ink mb-1">@DoctorNameFormatter.Format(Model.DoctorName)</h2>
                <span class="badge" style="background-color: #EAF4FA; color: #2D7DD2; font-size: 13px;">
                    @Model.DoctorSpecialization
                </span>
                <span class="text-secondary small d-block mt-1">Room @(string.IsNullOrEmpty(Model.RoomNumber) ? "02" : Model.RoomNumber)</span>
            </div>
        </div>

        <!-- Patient & Prescription Metadata Row -->
        <div class="row g-3 p-3 rounded mb-4" style="background-color: #F7F9FA; border: 1px solid #E2EBEC;">
            <div class="col-6 col-sm-3">
                <span class="text-secondary small d-block">Patient Name:</span>
                <strong class="text-ink">@Model.PatientName</strong>
            </div>
            <div class="col-6 col-sm-3">
                <span class="text-secondary small d-block">Patient Code:</span>
                <strong class="text-ink">@Model.PatientCode</strong>
            </div>
            <div class="col-6 col-sm-3">
                <span class="text-secondary small d-block">Age / DOB:</span>
                <span class="text-ink">@Model.Age yrs (@Model.DateOfBirth.ToString("dd MMM yyyy"))</span>
            </div>
            <div class="col-6 col-sm-3">
                <span class="text-secondary small d-block">Date of Issue:</span>
                <strong class="text-ink">@Model.AppointmentDate.ToString("dd MMM yyyy")</strong>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Diagnosis))
        {
            <div class="mb-4">
                <span class="text-secondary small text-uppercase fw-semibold d-block">Diagnosis:</span>
                <span class="fs-6 fw-semibold text-ink">@Model.Diagnosis</span>
            </div>
        }

        <!-- Rx Prescription Content -->
        <div class="d-flex align-items-center gap-3 mb-3">
            <span class="rx-symbol">℞</span>
            <span class="text-secondary small text-uppercase fw-bold letter-spacing-1">Medical Prescription</span>
        </div>

        <table class="table table-prescription w-100 mb-4">
            <thead>
                <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 45%;">Medication</th>
                    <th style="width: 25%;">Dosage</th>
                    <th style="width: 25%;">Frequency & Directions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Prescriptions.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-secondary py-4">
                            No prescribed medications recorded for this visit.
                        </td>
                    </tr>
                }
                else
                {
                    @for (int i = 0; i < Model.Prescriptions.Count; i++)
                    {
                        var item = Model.Prescriptions[i];
                        <tr>
                            <td class="text-secondary">@(i + 1)</td>
                            <td>
                                <strong class="text-ink d-block">@item.Medication</strong>
                            </td>
                            <td>@item.Dosage</td>
                            <td>@item.Frequency</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @if (!string.IsNullOrEmpty(Model.TreatmentNotes))
        {
            <div class="p-3 rounded mb-4" style="background-color: #FFFFFF; border: 1px dashed #E2EBEC;">
                <span class="text-secondary small text-uppercase fw-semibold d-block mb-1">Doctor's Clinical Instructions:</span>
                <p class="text-ink small mb-0">@Model.TreatmentNotes</p>
            </div>
        }

        <!-- Signature Block -->
        <div class="d-flex justify-content-between align-items-end pt-5 mt-4">
            <div class="text-secondary small">
                <span>Prescription Ref: <strong>RX-@(Model.PrescriptionId ?? Model.Id)</strong></span><br />
                <span>Generated by MediCare Clinical Information System</span>
            </div>
            <div>
                <div class="signature-line">
                    <strong class="d-block text-ink">@DoctorNameFormatter.Format(Model.DoctorName)</strong>
                    <span class="text-secondary small">@Model.DoctorSpecialization</span>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
