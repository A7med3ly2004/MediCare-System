@model MediCare.Web.ViewModels.Doctors.DoctorDetailsViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Dr. {Model.Doctor.FullName}";
    ViewData["ActiveNav"] = "doctors";
    var today = DateTime.UtcNow.AddHours(2);
}

<div class="mc-page-container pb-5">
    <!-- Back to directory or dashboard link (UI Match: Doctor profile.png) -->
    <div class="mb-3">
        @if (User.IsInRole("Doctor"))
        {
            <a asp-controller="Doctor" asp-action="Index" class="mc-back-link">
                <i class="bi bi-arrow-left"></i> BACK TO DASHBOARD
            </a>
        }
        else
        {
            <a asp-controller="Doctors" asp-action="Index" class="mc-back-link">
                <i class="bi bi-arrow-left"></i> BACK TO DOCTORS
            </a>
        }
    </div>

    <!-- Page Title Row -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
        <div>
            <h1 class="mc-page-title mb-1">Doctor profile</h1>
            <p class="mc-page-subtitle mb-0">Clinical expertise, practice details and appointment availability.</p>
        </div>
        <div>
            <span class="mc-text-secondary mc-fs-13 fw-medium">
                @DateTime.UtcNow.AddHours(2).ToString("dddd, dd MMMM yyyy")
            </span>
        </div>
    </div>

    <!-- ═══ HERO CARD (UI Match: Doctor profile.png) ════════════════════════════ -->
    <div class="mc-card p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-start gap-4">
                <!-- Avatar / Photo (Square 88x88) -->
                @if (!string.IsNullOrEmpty(Model.Doctor.ProfileImage))
                {
                    <img src="@Model.Doctor.ProfileImage"
                         alt="@Model.Doctor.FullName"
                         class="mc-doctor-avatar mc-doctor-avatar--square shadow-sm" />
                }
                else
                {
                    <div class="mc-doctor-avatar mc-doctor-avatar--square shadow-sm">
                        @(Model.Doctor.FullName.Length > 0 ? Model.Doctor.FullName.Substring(0, 1).ToUpper() : "D")
                    </div>
                }

                <div>
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <h2 class="h4 fw-bold text-ink mb-0">@DoctorNameFormatter.Format(Model.Doctor.FullName)</h2>
                        @if (Model.Doctor.IsAvailableToday)
                        {
                            <span class="mc-badge mc-badge--available">Available</span>
                        }
                        else
                        {
                            <span class="mc-badge mc-badge--off-duty">Off duty</span>
                        }
                    </div>
                    <p class="mc-text-primary fw-semibold mc-fs-14 mb-1">
                        Consultant @Model.Doctor.SpecializationName
                    </p>
                    <p class="mc-text-secondary mc-fs-13 mb-1">
                        Clinical Consultant · Al Nour Clinic Medical Staff
                    </p>
                    <p class="mc-text-secondary mc-fs-12 mb-0">
                        <i class="bi bi-geo-alt me-1"></i>Al Nour Clinic · @Model.Doctor.Location @(!string.IsNullOrEmpty(Model.Doctor.RoomNumber) ? $"· Room {Model.Doctor.RoomNumber}" : "")
                    </p>
                </div>
            </div>

            <!-- Consultation Fee & Action -->
            <div class="text-md-end mt-3 mt-md-0 pt-3 pt-md-0 border-top border-md-top-0 w-100 w-md-auto" style="border-color: var(--mc-hairline) !important;">
                <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Consultation fee</span>
                <span class="mc-fw-700 mc-text-ink fs-3 d-block mb-3">@Model.Doctor.ConsultationFee.ToString("N0") EGP</span>
                @if (Model.IsOwner)
                {
                    <a asp-action="Edit" class="mc-btn mc-btn-primary px-3 w-100 w-md-auto text-nowrap">
                        <i class="bi bi-pencil-square me-1"></i> Edit Profile
                    </a>
                }
                else if (User.IsInRole("Doctor"))
                {
                    <a asp-controller="Doctor" asp-action="Schedule" class="mc-btn mc-btn-secondary px-3 w-100 w-md-auto text-nowrap">
                        <i class="bi bi-calendar3 me-1"></i> My Schedule
                    </a>
                }
                else
                {
                    <a href="#availabilitySection" class="mc-btn mc-btn-primary px-3 w-100 w-md-auto">
                        <i class="bi bi-calendar-plus me-1"></i> Book appointment
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Secondary Navigation Tabs (UI Match: Doctor profile.png) -->
    <ul class="nav nav-tabs mb-4 border-bottom" style="border-color: var(--mc-hairline) !important;">
        <li class="nav-item">
            <a class="nav-link active fw-semibold text-ink" href="#overview">Overview</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-secondary" href="#schedule">Schedule</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-secondary" href="#about">About</a>
        </li>
    </ul>

    <!-- ═══ 2-COLUMN MAIN CONTENT ═══════════════════════════════════════════════ -->
    <div class="row g-4">
        <!-- ── Left Column (Wide) ──────────────────────────────────────────────── -->
        <div class="col-12 col-lg-7 col-xl-8">
            <!-- About Doctor Card -->
            <div class="mc-card p-4 mb-4" id="about">
                <h3 class="h6 fw-bold text-ink mb-3">About @DoctorNameFormatter.Format(Model.Doctor.FullName)</h3>
                <p class="mc-text-secondary mc-fs-14 lh-base mb-4">
                    @DoctorNameFormatter.Format(Model.Doctor.FullName) is a distinguished consultant in @Model.Doctor.SpecializationName at Al Nour Clinic.
                    Committed to providing comprehensive, evidence-based diagnostic and treatment services with personalized patient care.
                </p>

                <!-- Metadata 3-cols -->
                <div class="row g-3 py-3 border-top border-bottom mb-4" style="border-color: var(--mc-hairline) !important;">
                    <div class="col-4">
                        <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Specialty</span>
                        <span class="mc-text-ink mc-fs-14 fw-bold">@Model.Doctor.SpecializationName</span>
                    </div>
                    <div class="col-4">
                        <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Experience</span>
                        <span class="mc-text-ink mc-fs-14 fw-bold">10+ years</span>
                    </div>
                    <div class="col-4">
                        <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Languages</span>
                        <span class="mc-text-ink mc-fs-14 fw-bold">English, Arabic</span>
                    </div>
                </div>

                <!-- Clinical Focus -->
                <div>
                    <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-2">Clinical focus</span>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="mc-tag-pill">@Model.Doctor.SpecializationName</span>
                        <span class="mc-tag-pill">Clinical consultations</span>
                        <span class="mc-tag-pill">Diagnostic evaluations</span>
                        <span class="mc-tag-pill">Follow-up treatment</span>
                    </div>
                </div>
            </div>

            <!-- Weekly Practice Schedule Table -->
            <div class="mc-card p-4" id="schedule">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h6 fw-bold text-ink mb-0">Weekly Practice Schedule</h3>
                    <span class="badge" style="background-color: var(--mc-primary-light); color: var(--mc-confirmed-text); font-size: 11px;">
                        Recurring clinic hours
                    </span>
                </div>

                @if (Model.Doctor.Schedules.Any())
                {
                    <div class="table-responsive">
                        <table class="table mc-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Day of Week</th>
                                    <th>Working Hours</th>
                                    <th>Consultation Slot</th>
                                    <th>Clinic Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sched in Model.Doctor.Schedules)
                                {
                                    <tr>
                                        <td>
                                            <strong class="text-ink">@sched.DayName</strong>
                                        </td>
                                        <td>
                                            <span class="text-secondary">
                                                @sched.StartTime.ToString(@"hh\:mm") – @sched.EndTime.ToString(@"hh\:mm")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="mc-text-secondary">@sched.SlotMinutes minutes</span>
                                        </td>
                                        <td>
                                            <span class="mc-badge mc-badge--available">Scheduled</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="mc-text-secondary mc-fs-13 mb-0">
                        No recurring weekly schedule has been registered yet for this doctor.
                    </p>
                }

                @if (Model.Doctor.VacationDates.Any())
                {
                    <div class="mt-4 pt-3 border-top" style="border-color: var(--mc-hairline) !important;">
                        <h4 class="h6 fw-bold text-ink mb-2">Upcoming Planned Leave</h4>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var vac in Model.Doctor.VacationDates)
                            {
                                <span class="badge border" style="background: var(--mc-canvas); color: var(--mc-secondary-text); border-color: var(--mc-hairline) !important;">
                                    <i class="bi bi-calendar-x me-1"></i>@vac.ToString("ddd, dd MMM yyyy")
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- ── Right Column (Interactive Booking for Patients / Practice Management for Doctors) ── -->
        <div class="col-12 col-lg-5 col-xl-4">
            @if (User.IsInRole("Doctor"))
            {
                @if (Model.IsOwner)
                {
                    <!-- Doctor Self-Management Card -->
                    <div class="mc-card p-4 mb-4">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-person-gear text-primary fs-5"></i>
                            <h3 class="h6 fw-bold text-ink mb-0">Profile & Schedule Management</h3>
                        </div>
                        <p class="text-secondary small mb-3">You are previewing your public clinical profile as seen by clinic patients.</p>

                        <div class="d-grid gap-2">
                            <a asp-action="Edit" class="mc-btn mc-btn-primary text-center">
                                <i class="bi bi-pencil-square me-1"></i> Edit Profile Details
                            </a>
                            <a asp-controller="Doctor" asp-action="Schedule" class="mc-btn mc-btn-secondary text-center">
                                <i class="bi bi-calendar3 me-1"></i> Manage Weekly Schedule & Vacations
                            </a>
                            <a asp-controller="Doctor" asp-action="Index" class="mc-btn mc-btn-ghost text-center">
                                <i class="bi bi-grid-1x2 me-1"></i> Return to Doctor Dashboard
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Availability Card (UI Match: Doctor profile.png) -->
                <div class="mc-card p-4 mb-4" id="availabilitySection">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="h6 fw-bold text-ink mb-0">Availability & Booking</h3>
                        <span class="mc-text-secondary mc-fs-12">
                            @DateTime.UtcNow.AddHours(2).ToString("MMM yyyy")
                        </span>
                    </div>

                    <!-- Interactive Week Day Pills -->
                    <div class="d-flex justify-content-between gap-1 mb-3" id="weekDayPillsContainer">
                        @{
                            for (int i = 0; i < 6; i++)
                            {
                                var dt = today.AddDays(i);
                                var dateStr = dt.ToString("yyyy-MM-dd");
                                var isSelected = (i == 0);
                                <button type="button"
                                        class="mc-day-pill @(isSelected ? "active" : "") border-0"
                                        data-date="@dateStr"
                                        onclick="selectDayPill(this, '@dateStr')">
                                    <span class="mc-day-pill__day">@dt.ToString("ddd")[0]</span>
                                    <span class="mc-day-pill__num">@dt.Day</span>
                                </button>
                            }
                        }
                    </div>

                    <!-- Selected Date Info -->
                    <div class="mb-3">
                        <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Selected Date</span>
                        <span class="mc-text-ink mc-fs-13 fw-bold" id="selectedDateDisplay">
                            @today.ToString("dddd, dd MMMM yyyy")
                        </span>
                    </div>

                    <!-- Dynamic Slots Container -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold">Available appointment times</span>
                            <span class="badge" id="slotsCountBadge" style="background-color: var(--mc-primary-light); color: var(--mc-confirmed-text); font-size: 11px;">
                                Loading...
                            </span>
                        </div>

                        <!-- Slot buttons injected via JS -->
                        <div class="d-flex flex-wrap gap-2 mb-3" id="slotsButtonList" style="min-height: 48px;">
                            <span class="mc-text-secondary mc-fs-12 fst-italic">Loading available slots…</span>
                        </div>

                        <span class="mc-text-secondary mc-fs-11 d-block mb-3">
                            In-clinic consultations · Al Nour Clinic
                        </span>

                        @if (User.IsInRole("Patient"))
                        {
                            <button type="button"
                                    class="mc-btn mc-btn-primary w-100"
                                    id="bookSelectedSlotBtn"
                                    disabled
                                    onclick="openBookingModal()">
                                Book selected time
                            </button>
                        }
                        else if (!User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="mc-btn mc-btn-primary w-100 text-center">
                                Sign in to book an appointment
                            </a>
                        }
                        else
                        {
                            <button type="button" class="mc-btn mc-btn-ghost w-100" disabled>
                                Booking reserved for Patient portal
                            </button>
                        }
                    </div>

                    <div class="border-top pt-3" style="border-color: var(--mc-hairline) !important;">
                        <p class="mc-text-secondary mc-fs-11 mb-0">
                            Regular clinic hours: Mon–Sat, 09:00 AM–06:00 PM. Friday by appointment.
                        </p>
                    </div>
                </div>
            }

            <!-- Contact Information Card (UI Match: Doctor profile.png) -->
            <div class="mc-card p-4">
                <h3 class="h6 fw-bold text-ink mb-3">Contact information</h3>

                <div class="mb-3">
                    <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Phone number</span>
                    <span class="mc-text-ink mc-fs-14 fw-medium">
                        @(string.IsNullOrEmpty(Model.Doctor.PhoneNumber) ? "+20 100 000 0000" : Model.Doctor.PhoneNumber)
                    </span>
                </div>

                <div class="mb-3">
                    <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Email address</span>
                    <span class="mc-text-ink mc-fs-14 fw-medium text-break">
                        @Model.Doctor.Email
                    </span>
                </div>

                <div class="mb-3">
                    <span class="mc-text-secondary mc-fs-11 text-uppercase fw-semibold d-block mb-1">Reception</span>
                    <span class="mc-text-ink mc-fs-14 fw-medium">
                        +20 2 2561 0340
                    </span>
                </div>

                @if (Model.CanEditProfile)
                {
                    <div class="pt-3 border-top mt-3" style="border-color: var(--mc-hairline) !important;">
                        <a asp-action="Edit" asp-route-id="@Model.Doctor.Id" class="mc-link fw-semibold mc-fs-13 text-decoration-none d-inline-flex align-items-center">
                            Edit doctor information <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (!User.IsInRole("Doctor"))
{
    <!-- ═══ BOOKING CONFIRMATION MODAL ════════════════════════════════════════════ -->
    <div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: var(--mc-radius);">
                <div class="modal-header border-bottom" style="border-color: var(--mc-hairline) !important;">
                    <h5 class="modal-title h6 fw-bold text-ink" id="bookingModalLabel">
                        <i class="bi bi-calendar-check text-primary me-2"></i> Confirm Appointment Booking
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Patient" asp-action="Book" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="DoctorId" value="@Model.Doctor.Id" />
                    <input type="hidden" name="AppointmentDate" id="modalAppointmentDate" />
                    <input type="hidden" name="StartTime" id="modalStartTime" />
                    <input type="hidden" name="EndTime" id="modalEndTime" />

                    <div class="modal-body p-4">
                        <div class="p-3 rounded mb-3" style="background-color: var(--mc-canvas); border: 1px solid var(--mc-hairline);">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="mc-text-secondary mc-fs-12">Doctor:</span>
                                <strong class="text-ink mc-fs-13">@DoctorNameFormatter.Format(Model.Doctor.FullName)</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="mc-text-secondary mc-fs-12">Specialization:</span>
                                <span class="text-ink mc-fs-13">@Model.Doctor.SpecializationName</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="mc-text-secondary mc-fs-12">Date:</span>
                                <strong class="text-ink mc-fs-13" id="modalDateFormatted"></strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="mc-text-secondary mc-fs-12">Time:</span>
                                <strong class="text-primary mc-fs-13" id="modalTimeFormatted"></strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="mc-text-secondary mc-fs-12">Consultation Fee:</span>
                                <strong class="text-ink mc-fs-13">@Model.Doctor.ConsultationFee.ToString("N0") EGP</strong>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label mc-fs-13 fw-semibold text-ink">Reason for visit / symptoms (optional)</label>
                            <textarea name="Notes"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Briefly describe your symptoms or reason for consulting @DoctorNameFormatter.Format(Model.Doctor.FullName)…"></textarea>
                        </div>

                        <p class="mc-text-secondary mc-fs-11 mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            New appointments are submitted as <strong>Pending</strong>. You will receive an email once confirmed. Cancellations or rescheduling are permitted up to 2 hours in advance.
                        </p>
                    </div>

                    <div class="modal-footer border-top" style="border-color: var(--mc-hairline) !important;">
                        <button type="button" class="mc-btn mc-btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="mc-btn mc-btn-primary px-4">
                            <i class="bi bi-check2-circle me-1"></i> Submit Booking Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
@if (!User.IsInRole("Doctor"))
{
    <script>
        const doctorId = @Model.Doctor.Id;
        let allFreeSlots = [];
        let selectedDateStr = '@today.ToString("yyyy-MM-dd")';
        let selectedSlot = null;

        document.addEventListener('DOMContentLoaded', function () {
            loadDoctorSlots();
        });

        async function loadDoctorSlots() {
            const badge = document.getElementById('slotsCountBadge');
            const list = document.getElementById('slotsButtonList');

            try {
                const response = await fetch(`/Schedule/FreeSlots?doctorId=${doctorId}`);
                if (!response.ok) throw new Error('Failed to load slots');
                allFreeSlots = await response.json();
                renderSlotsForSelectedDate();
            } catch (err) {
                console.error(err);
                if (badge) badge.textContent = 'Error';
                if (list) list.innerHTML = '<span class="text-danger mc-fs-12">Failed to load time slots. Please refresh the page.</span>';
            }
        }

        function selectDayPill(btn, dateStr) {
            document.querySelectorAll('#weekDayPillsContainer .mc-day-pill').forEach(el => el.classList.remove('active'));
            btn.classList.add('active');

            selectedDateStr = dateStr;
            const parsed = new Date(dateStr + 'T00:00:00');
            const dateDisplay = document.getElementById('selectedDateDisplay');
            if (dateDisplay) {
                dateDisplay.textContent = parsed.toLocaleDateString('en-US', {
                    weekday: 'long',
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });
            }

            selectedSlot = null;
            const bookBtn = document.getElementById('bookSelectedSlotBtn');
            if (bookBtn) bookBtn.disabled = true;
            renderSlotsForSelectedDate();
        }

        function renderSlotsForSelectedDate() {
            const list = document.getElementById('slotsButtonList');
            const badge = document.getElementById('slotsCountBadge');
            if (!list || !badge) return;
            list.innerHTML = '';

            const daySlots = allFreeSlots.filter(s => s.extendedProps.date === selectedDateStr);
            badge.textContent = `${daySlots.length} available`;

            if (daySlots.length === 0) {
                list.innerHTML = '<span class="mc-text-secondary mc-fs-12 fst-italic">No free slots on this date (doctor off duty, vacation, or fully booked).</span>';
                return;
            }

            daySlots.forEach(slot => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'mc-slot-btn';
                btn.textContent = slot.extendedProps.startTime;
                btn.title = slot.extendedProps.formattedTime;

                btn.onclick = function () {
                    document.querySelectorAll('#slotsButtonList .mc-slot-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    selectedSlot = slot;
                    const bookBtn = document.getElementById('bookSelectedSlotBtn');
                    if (bookBtn) bookBtn.disabled = false;
                };

                list.appendChild(btn);
            });
        }

        function openBookingModal() {
            if (!selectedSlot) return;

            document.getElementById('modalAppointmentDate').value = selectedSlot.extendedProps.date;
            document.getElementById('modalStartTime').value = selectedSlot.extendedProps.startTime;
            document.getElementById('modalEndTime').value = selectedSlot.extendedProps.endTime;

            const dt = new Date(selectedSlot.extendedProps.date + 'T00:00:00');
            document.getElementById('modalDateFormatted').textContent = dt.toLocaleDateString('en-US', {
                weekday: 'short',
                day: 'numeric',
                month: 'short',
                year: 'numeric'
            });

            document.getElementById('modalTimeFormatted').textContent = selectedSlot.extendedProps.formattedTime;

            const modalEl = document.getElementById('bookingModal');
            if (modalEl) {
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        }
    </script>
}
}
