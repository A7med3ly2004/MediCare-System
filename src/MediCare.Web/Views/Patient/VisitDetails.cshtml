@model MediCare.Services.MedicalRecords.MedicalRecordDetailDto
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Visit Details — {Model.AppointmentDate:dd MMM yyyy}";
}

<div class="mc-page-container pb-5">
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <a asp-action="History" class="text-secondary small text-decoration-none fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> BACK TO MEDICAL HISTORY
        </a>
        @if (Model.Prescriptions.Any())
        {
            <a asp-controller="Prescription" asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="mc-btn mc-btn-primary mc-btn-sm">
                <i class="bi bi-printer me-1"></i> Print prescription
            </a>
        }
    </div>

    <!-- Visit Header Card -->
    <div class="mc-card p-4 mb-4" style="background-color: #F8FBFE; border: 1px solid #D6EBF8;">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <span class="mc-badge mc-badge--completed mb-2 d-inline-block">Completed Visit</span>
                <h1 class="h4 fw-bold text-ink mb-1">@Model.Diagnosis</h1>
                <p class="text-secondary small mb-0">
                    Consultation with <strong>Dr. @Model.DoctorName</strong> (@Model.DoctorSpecialization) on @Model.AppointmentDate.ToString("dddd, dd MMMM yyyy") at @Model.FormattedTime
                </p>
            </div>
            <div class="text-md-end">
                <span class="text-secondary small d-block">Location</span>
                <strong class="text-ink small">Al Nour Clinic · Room @(string.IsNullOrEmpty(Model.RoomNumber) ? "02" : Model.RoomNumber)</strong>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <!-- Vitals Summary -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6">
                    <div class="mc-card p-3">
                        <span class="text-secondary small d-block mb-1">Blood pressure</span>
                        <div class="h5 fw-bold text-ink mb-0">
                            @(string.IsNullOrEmpty(Model.BloodPressure) ? "Not recorded" : Model.BloodPressure)
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <div class="mc-card p-3">
                        <span class="text-secondary small d-block mb-1">Heart rate</span>
                        <div class="h5 fw-bold text-ink mb-0">
                            @(Model.HeartRate.HasValue ? $"{Model.HeartRate} bpm" : "Not recorded")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Clinical Findings -->
            <div class="mc-card p-4 mb-4">
                <h2 class="h6 fw-bold text-ink mb-3 pb-2 border-bottom">Consultation Details</h2>

                <div class="mb-3">
                    <span class="text-secondary small d-block mb-1">Reported symptoms:</span>
                    <p class="text-ink small mb-0">
                        @(string.IsNullOrEmpty(Model.Symptoms) ? "None recorded." : Model.Symptoms)
                    </p>
                </div>

                <div class="mb-3">
                    <span class="text-secondary small d-block mb-1">Diagnosis:</span>
                    <strong class="text-ink small">@Model.Diagnosis</strong>
                </div>

                <div>
                    <span class="text-secondary small d-block mb-1">Doctor's advice & treatment notes:</span>
                    <p class="text-ink small mb-0">
                        @(string.IsNullOrEmpty(Model.TreatmentNotes) ? "No specific instructions recorded." : Model.TreatmentNotes)
                    </p>
                </div>
            </div>

            <!-- Digital Prescription -->
            <div class="mc-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h2 class="h6 fw-bold text-ink mb-0">
                        <i class="bi bi-capsule text-primary me-1"></i> Prescribed Medications
                    </h2>
                    @if (Model.Prescriptions.Any())
                    {
                        <a asp-controller="Prescription" asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="mc-btn mc-btn-primary mc-btn-sm">
                            <i class="bi bi-printer me-1"></i> Print prescription
                        </a>
                    }
                </div>

                @if (!Model.Prescriptions.Any())
                {
                    <p class="text-secondary small mb-0">No prescription medications were issued during this visit.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mc-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Medication</th>
                                    <th>Dosage</th>
                                    <th>Frequency / Instructions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Prescriptions.Count; i++)
                                {
                                    var item = Model.Prescriptions[i];
                                    <tr>
                                        <td class="text-secondary small">@(i + 1)</td>
                                        <td><strong class="text-ink">@item.Medication</strong></td>
                                        <td>@item.Dosage</td>
                                        <td>@item.Frequency</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="mc-card p-4 mb-3">
                <h3 class="h6 fw-bold text-ink mb-3">Doctor Information</h3>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div style="width: 44px; height: 44px; background-color: var(--mc-primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--mc-ink);">
                        @(Model.DoctorName.Length > 0 ? Model.DoctorName.Substring(0, 1) : "D")
                    </div>
                    <div>
                        <strong class="d-block text-ink">Dr. @Model.DoctorName</strong>
                        <span class="text-secondary small">@Model.DoctorSpecialization</span>
                    </div>
                </div>
                <div class="pt-2 border-top small text-secondary">
                    <span>Consultation Room: <strong>@(string.IsNullOrEmpty(Model.RoomNumber) ? "02" : Model.RoomNumber)</strong></span>
                </div>
            </div>

            <div class="mc-card p-3 text-secondary small">
                <div class="d-flex justify-content-between py-1">
                    <span>Visit recorded:</span>
                    <strong class="text-ink">@Model.CreatedAt.ToString("g")</strong>
                </div>
            </div>
        </div>
    </div>
</div>
