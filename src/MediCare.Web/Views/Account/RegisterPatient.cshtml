@model MediCare.Web.ViewModels.Account.RegisterPatientViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Patient Registration";
}

<div class="mc-auth-card" style="max-width: 640px;">
    <div class="text-center mb-4">
        <a asp-controller="Home" asp-action="Index" class="mc-auth-logo justify-content-center">
            <span class="mc-auth-logo-icon">+</span>
            <span>MediCare</span>
        </a>
        <h1 class="mc-auth-title mt-2">Patient Registration</h1>
        <p class="mc-auth-subtitle">Create your personal clinic care account</p>
    </div>

    @await Html.PartialAsync("_ValidationSummary")

    <form asp-controller="Account" asp-action="RegisterPatient" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="FullName" class="mc-form-label">
                        Full name <span class="required">*</span>
                    </label>
                    <input asp-for="FullName" class="form-control mc-input" placeholder="e.g. Ahmed Tarek" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="PhoneNumber" class="mc-form-label">
                        Phone number
                    </label>
                    <input asp-for="PhoneNumber" class="form-control mc-input" type="tel" placeholder="+20 100 123 4567" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="Email" class="mc-form-label">
                        Email address <span class="required">*</span>
                    </label>
                    <input asp-for="Email" class="form-control mc-input" type="email" placeholder="patient@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="DateOfBirth" class="mc-form-label">
                        Date of birth <span class="required">*</span>
                    </label>
                    <input asp-for="DateOfBirth" class="form-control mc-input" type="date" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="Password" class="mc-form-label">
                        Password <span class="required">*</span>
                    </label>
                    <input asp-for="Password" class="form-control mc-input" type="password" placeholder="At least 8 characters" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="ConfirmPassword" class="mc-form-label">
                        Confirm password <span class="required">*</span>
                    </label>
                    <input asp-for="ConfirmPassword" class="form-control mc-input" type="password" placeholder="Re-enter password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="BloodGroup" class="mc-form-label">
                        Blood group
                    </label>
                    <select asp-for="BloodGroup" class="form-select mc-input">
                        <option value="">Select blood group (optional)</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                    </select>
                    <span asp-validation-for="BloodGroup" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="mc-form-group">
                    <label asp-for="Allergies" class="mc-form-label">
                        Known allergies
                    </label>
                    <input asp-for="Allergies" class="form-control mc-input" placeholder="e.g. Penicillin, Peanuts" />
                    <span asp-validation-for="Allergies" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>

        <div class="mc-form-group mb-3">
            <label asp-for="MedicalHistory" class="mc-form-label">
                Medical history
            </label>
            <textarea asp-for="MedicalHistory" class="form-control mc-input" rows="2" placeholder="Chronic conditions, previous surgeries, or regular medication..."></textarea>
            <span asp-validation-for="MedicalHistory" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="AcceptedPrivacyNotice" class="form-check-input" type="checkbox" id="privacyNotice" />
            <label asp-for="AcceptedPrivacyNotice" class="form-check-label text-secondary small" for="privacyNotice">
                I agree to the <a href="#" class="text-primary">Terms of Care</a> and <a href="#" class="text-primary">Privacy Notice</a>. <span class="required">*</span>
            </label>
            <span asp-validation-for="AcceptedPrivacyNotice" class="text-danger small mt-1 d-block"></span>
        </div>

        <button type="submit" class="mc-btn mc-btn-primary w-100 py-2 mb-3">
            Complete Registration
        </button>

        <div class="mc-auth-footer">
            Already registered?
            <a asp-controller="Account" asp-action="Login" class="fw-semibold ms-1">Sign in here</a>
        </div>
    </form>
</div>
